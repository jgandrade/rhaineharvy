---
/**
 * Vero's "YOUR MOST important DRESS / DESERVES TO LAST forever." beat: the
 * first line sits above a tall portrait, the second rises in over the
 * portrait and travels with it, then the portrait dissolves into the
 * invitation copy.
 */
import Media from "./Media.astro";
import Rich from "./Rich.astro";
import { CTA, PROMISE } from "../lib/site";
---

<section class="promise" aria-labelledby="promise-title">
  <h2 class="display promise__top" id="promise-title" data-reveal>
    <Rich text={PROMISE.top} />
  </h2>

  <div class="promise__stage" data-promise-stage>
    <Media
      slug="promise-portrait"
      label="Portrait - full length"
      tone="stone"
      sizes="(min-width: 900px) 34vw, 80vw"
      class="promise__figure"
    />
    <div class="promise__lane">
      <!-- Two copies of the line: ink everywhere, ivory clipped to the photo's
           width, so it reads on both the ground and the picture. -->
      <div class="promise__bottom" aria-hidden="true" data-promise-bottom>
        <p class="display promise__ink"><Rich text={PROMISE.bottom} /></p>
        <p class="display promise__light"><Rich text={PROMISE.bottom} /></p>
      </div>
    </div>
  </div>

  <div class="promise__copy" data-fade>
    <p class="title">{PROMISE.title}</p>
    <p class="prose">{PROMISE.body}</p>
    <a class="btn" href={CTA.href} data-scroll-to><Rich text={CTA.label} /></a>
  </div>
</section>

<style>
  .promise {
    /* Portrait width, shared by the photo and the ivory copy's clip. */
    --fig-w: min(80vw, 520px);
    position: relative;
    padding: 22vh var(--gutter) 18vh;
  }

  @media (min-width: 900px) {
    .promise {
      --fig-w: min(34vw, 560px);
    }
  }

  .promise__top {
    position: relative;
    z-index: 2;
  }

  .promise__stage {
    position: relative;
    display: grid;
    justify-items: center;
    margin-top: -0.6em;
  }

  .promise__stage :global(.promise__figure) {
    width: var(--fig-w);
    height: 150vh;
    /* Dissolve into the ground like Vero's cut-out sculpture. */
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 72%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 72%, transparent 100%);
  }

  /*
   * A lane over the portrait. The second line sits well down it and rises in
   * as it arrives, then travels with the portrait.
   */
  .promise__lane {
    position: absolute;
    inset: 0;
    z-index: 2;
    padding-top: 62vh;
    padding-bottom: 30vh;
  }

  .promise__bottom {
    display: grid;
    font-size: var(--fs-display-1);
  }

  .promise__ink,
  .promise__light {
    grid-area: 1 / 1;
  }

  .promise__light {
    color: var(--ivory);
    text-shadow: 0 2px 30px rgb(34 7 13 / 0.35);
    clip-path: inset(-10% calc((100% - var(--fig-w)) / 2));
  }

  .promise__copy {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 18px;
    max-width: 440px;
    margin: -6vh auto 0;
  }

  .promise__copy .btn {
    margin-top: 18px;
  }
</style>
