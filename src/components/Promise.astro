---
/**
 * The invitation, Figma "B - Polished": the head, a portrait, and the second
 * half of the line ("TO KEEP for ALWAYS.") set over the portrait's lower
 * edge, then the invitation copy and the one primary button on the screen.
 */
import Media from "./Media.astro";
import Rich from "./Rich.astro";
import { CTA, PROMISE } from "../lib/site";
---

<section class="promise" aria-labelledby="promise-title">
  <header class="v2-head">
    <p class="v2-label">{PROMISE.eyebrow}</p>
    <h2 class="v2-display-l" id="promise-title" data-reveal><Rich text={PROMISE.top} /></h2>
  </header>

  <div class="promise__stage" data-promise-stage>
    <Media
      slug="promise-portrait"
      label="Portrait"
      tone="stone"
      sizes="(min-width: 900px) 460px, 300px"
      class="promise__portrait"
    />
    <p class="v2-display-l promise__bottom" data-promise-bottom><Rich text={PROMISE.bottom} /></p>
  </div>

  <div class="promise__invite">
    <p class="v2-title">{PROMISE.title}</p>
    <p class="v2-body">{PROMISE.body}</p>
    <a class="bv2 bv2--primary promise__cta" href={CTA.href} data-scroll-to>{CTA.label}</a>
  </div>
</section>

<style>
  .promise {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding: 96px var(--gutter);
    background: var(--ivory);
    color: var(--ink);
  }

  .promise__stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .promise__stage :global(.promise__portrait) {
    width: 300px;
    height: 440px;
    max-width: 100%;
  }

  /* The line sits over the photo's last 40px (130px on desktop). */
  .promise__bottom {
    position: relative;
    margin-top: -40px;
    text-align: center;
  }

  .promise__invite {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
    max-width: 520px;
    text-align: center;
  }

  /* Body to button: gap 16 + spacer 8 + gap 16 on phones. */
  .promise__invite .v2-body {
    margin-bottom: 24px;
  }

  .promise__cta {
    width: 100%;
  }

  @media (min-width: 900px) {
    .promise {
      gap: 0;
      padding: 160px var(--gutter);
    }

    .promise__stage {
      margin-top: 27px;
    }

    .promise__stage :global(.promise__portrait) {
      width: 460px;
      height: 640px;
    }

    .promise__bottom {
      margin-top: -130px;
      white-space: nowrap;
    }

    .promise__invite {
      margin-top: 78px;
    }

    .promise__invite .v2-body {
      opacity: 0.82;
      margin-bottom: 40px;
    }

    .promise__cta {
      width: auto;
    }
  }
</style>
