---
/**
 * Full-bleed opener, Figma "B - Polished": the photo under a wine shade, and
 * low on it the invitation line, the names and the date. Phones get their own
 * photo (moment-07, the portrait in black) and break the names after RHAINE.
 *
 * The preloader window lands here; on scroll the frame draws in to a card
 * while the names sink and fade (motion.ts).
 */
import Media from "./Media.astro";
import Rich from "./Rich.astro";
import { HERO, SITE } from "../lib/site";
---

<section class="hero" id="top" data-hero>
  <div class="hero__frame" data-hero-frame>
    {
      SITE.heroVideo ? (
        <video class="hero__media hero__video" src={SITE.heroVideo} autoplay muted loop playsinline preload="auto" />
      ) : (
        <>
          <Media slug="hero" label="Hero - couple portrait" tone="wine" class="hero__media hero__media--wide" />
          <Media slug="moment-07" label="Hero - couple portrait" tone="wine" sizes="100vw" class="hero__media hero__media--tall" />
        </>
      )
    }
    <div class="hero__shade" aria-hidden="true"></div>
  </div>

  <div class="hero__brand" data-hero-brand>
    <p class="v2-label">{HERO.kicker}</p>
    <h1 class="hero__names"><Rich text={HERO.names} /></h1>
    <p class="v2-label">
      <span class="hero__date-long">{HERO.date}</span>
      <span class="hero__date-short">{HERO.dateShort}</span>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 780px;
    color: var(--ivory);
    background: var(--wine-deep);
  }

  @media (min-width: 900px) {
    .hero {
      height: 900px;
    }
  }

  .hero__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    will-change: clip-path;
  }

  .hero__frame :global(.hero__media) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__frame :global(.hero__media--wide) {
    display: none;
  }

  @media (min-width: 900px) {
    .hero__frame :global(.hero__media--wide) {
      display: block;
    }

    .hero__frame :global(.hero__media--tall) {
      display: none;
    }
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(34 7 13 / 0.35),
      rgb(34 7 13 / 0.2) 45%,
      rgb(34 7 13 / 0.7)
    );
  }

  @media (min-width: 900px) {
    .hero__shade {
      background: linear-gradient(
        to bottom,
        rgb(34 7 13 / 0.35),
        rgb(34 7 13 / 0.25) 50%,
        rgb(34 7 13 / 0.6)
      );
    }
  }

  .hero__brand {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 0 var(--gutter);
    text-align: center;
    pointer-events: none;
  }

  @media (min-width: 900px) {
    .hero__brand {
      bottom: 160px;
      gap: 24px;
    }
  }

  /* m/Display XL 64 on phones (two lines), Display L 112 on one line. */
  .hero__names {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 64px;
    line-height: 0.95;
    letter-spacing: -0.96px;
  }

  .hero__names :global(em) {
    font-family: var(--font-serif);
    font-style: italic;
  }

  @media (min-width: 900px) {
    .hero__names {
      font-size: min(112px, 7.78vw);
      letter-spacing: -0.015em;
      white-space: nowrap;
    }

    .hero__names :global(.line),
    .hero__names :global(.line__inner) {
      display: inline;
    }
  }

  .hero__date-long {
    display: none;
  }

  @media (min-width: 900px) {
    .hero__date-long {
      display: inline;
    }

    .hero__date-short {
      display: none;
    }
  }
</style>
