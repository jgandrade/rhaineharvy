---
/**
 * Fixed chrome, as the Figma "B - Polished" header draws it: MENU as a light
 * text link on the left, the couple's names in the middle (desktop only) and
 * the ivory "On photo" reply button on the right. Over the hero it is clear;
 * once the hero has gone it turns into an ivory bar with ink type and the
 * wine primary button, so it still reads over every section.
 */
import Rich from "./Rich.astro";
import { CTA, HEADER, NAV, SITE } from "../lib/site";
---

<header class="header" data-header>
  <button
    class="bv2 bv2--link-light header__menu"
    type="button"
    aria-expanded="false"
    aria-controls="menu"
    data-menu-toggle
  >
    <span class="header__swap">
      <span class="header__swap-a">{HEADER.menu}</span>
      <span class="header__swap-b" aria-hidden="true">{HEADER.close}</span>
    </span>
  </button>

  <a class="header__brand" href="#top" data-scroll-to aria-label={`${SITE.couple} - back to top`}>
    {SITE.bride} <em>&amp;</em> {SITE.groom}
  </a>

  <a class="bv2 bv2--photo header__cta" href={CTA.href} data-scroll-to>
    <span class="header__cta-long">{CTA.label}</span>
    <span class="header__cta-short" aria-hidden="true">{CTA.short}</span>
  </a>
</header>

<div class="menu" id="menu" data-menu>
  <nav class="menu__panel" aria-label="Primary">
    <ol class="menu__list">
      {
        NAV.map((item) => (
          <li class="menu__item">
            <span class="menu__n">{item.n}</span>
            <a class="menu__link" href={item.href} data-scroll-to>
              <span class="line">
                <span class="line__inner">{item.label}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
    <div class="menu__aside">
      <p class="menu__date">
        <span>The wedding of</span>
        {SITE.couple}<br />
        {SITE.dateLong}
      </p>
      {SITE.contact && <p>{SITE.contact}</p>}
    </div>
  </nav>
  <button class="menu__scrim" type="button" tabindex="-1" aria-label="Close menu" data-menu-close></button>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    padding: 0 16px;
    color: var(--ivory);
    transition:
      background-color 0.5s var(--ease-out-expo),
      color 0.5s var(--ease-out-expo),
      box-shadow 0.5s var(--ease-out-expo);
  }

  @media (min-width: 900px) {
    .header {
      height: 88px;
      padding: 0 40px;
    }
  }

  /* Past the hero: an ivory bar, ink type, the wine primary button. */
  :global(.header.is-solid),
  :global(html.menu-open) .header {
    background: var(--ivory);
    color: var(--ink);
    box-shadow: 0 1px 0 var(--ink-faint);
  }

  .header__menu {
    color: inherit;
  }

  :global(.header.is-solid) .header__cta,
  :global(html.menu-open) .header__cta {
    background: var(--wine);
    color: var(--ivory);
  }

  /* Phones: a 48px "RSVP →". Desktop: the full 56px "KINDLY RSVP →". */
  .header__cta {
    height: 48px;
    padding: 0 20px;
  }

  .header__cta-long {
    display: none;
  }

  @media (min-width: 900px) {
    .header__cta {
      height: 56px;
      padding: 0 32px;
    }

    .header__cta-long {
      display: inline;
    }

    .header__cta-short {
      display: none;
    }
  }

  .header__brand {
    display: none;
    position: absolute;
    left: 50%;
    translate: -50% 0;
    font-family: var(--font-serif);
    font-size: 28px;
    line-height: 1.25;
    white-space: nowrap;
  }

  .header__brand em {
    font-style: italic;
  }

  @media (min-width: 900px) {
    .header__brand {
      display: block;
    }
  }

  /* MENU <-> CLOSE roll. Both labels share one grid cell. */
  .header__swap {
    display: grid;
    justify-items: start;
    overflow: hidden;
    white-space: nowrap;
  }

  .header__swap-a,
  .header__swap-b {
    grid-area: 1 / 1;
    transition: transform 0.6s var(--ease-out-expo);
  }

  .header__swap-b {
    transform: translateY(110%);
  }

  :global(html.menu-open) .header__swap-a {
    transform: translateY(-110%);
  }

  :global(html.menu-open) .header__swap-b {
    transform: none;
  }

  /* ---------------- Menu ---------------- */

  .menu {
    position: fixed;
    inset: 0;
    z-index: 110;
    visibility: hidden;
    transition: visibility 0s 0.9s;
  }

  :global(html.menu-open) .menu {
    visibility: visible;
    transition: none;
  }

  .menu__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(34 7 13 / 0.45);
    opacity: 0;
    transition: opacity 0.7s var(--ease-out-expo);
  }

  :global(html.menu-open) .menu__scrim {
    opacity: 1;
  }

  .menu__panel {
    position: relative;
    display: grid;
    gap: 32px;
    padding: calc(var(--header-h) + 16px) var(--gutter) 28px;
    background:
      radial-gradient(60% 80% at 85% 0%, rgb(201 154 160 / 0.2), transparent 70%),
      var(--ivory);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s var(--ease-in-out-quart);
  }

  :global(html.menu-open) .menu__panel {
    clip-path: inset(0 0 0 0);
  }

  @media (min-width: 900px) {
    .menu__panel {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }


  .menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu__item {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .menu__n {
    width: 2.2em;
    flex: none;
    font-family: var(--font-serif);
    font-size: var(--fs-micro);
    color: var(--ink-soft);
  }

  .menu__link {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.5rem, 5.4vw, 4.75rem);
    line-height: 1.02;
    text-transform: uppercase;
    background: linear-gradient(currentColor, currentColor) 0 90% / 0 1px no-repeat;
    transition:
      background-size 0.6s var(--ease-out-expo),
      color 0.4s;
  }

  @media (hover: hover) {
    .menu__link:hover {
      color: var(--wine);
      background-size: 100% 1px;
    }
  }

  .menu__link .line__inner {
    transform: translateY(105%);
    transition: transform 0.9s var(--ease-out-expo);
  }

  :global(html.menu-open) .menu__link .line__inner {
    transform: none;
    transition-delay: calc(0.25s + var(--i, 0) * 0.05s);
  }

  .menu__item:nth-child(2) { --i: 1; }
  .menu__item:nth-child(3) { --i: 2; }
  .menu__item:nth-child(4) { --i: 3; }
  .menu__item:nth-child(5) { --i: 4; }
  .menu__item:nth-child(6) { --i: 5; }

  .menu__aside {
    display: grid;
    gap: 12px;
    font-style: italic;
    font-size: var(--fs-tiny);
    color: var(--ink-soft);
  }

  @media (min-width: 900px) {
    .menu__aside {
      text-align: right;
    }
  }

  .menu__date span {
    display: block;
    font-style: normal;
    color: var(--ink);
  }
</style>
