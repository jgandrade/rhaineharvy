---
/**
 * V4 "Good to know", on wine-deep. Desktop: two columns - "Before you
 * Arrive." and its one-line lede hold still on the left while the three
 * notes stack on the right as slim rows: the icon in a ring, a short title
 * and one line, and a large outlined script numeral at the far end. Phones:
 * the heading, then the rows.
 *
 * Motion (scripts/v4.ts, notes()): each row wipes open left to right in
 * turn, its icon draws itself stroke by stroke and its numeral rises. Hover
 * lifts the row, warms the ring and nudges the numeral.
 */
import { V4, bold } from "../../lib/site";
import gathering from "../../icons/gathering.svg?raw";
import guests from "../../icons/guests.svg?raw";
import gift from "../../icons/gift.svg?raw";

const icons: Record<string, string> = { gathering, guests, gift };
---

<section class="notes" id="notes" aria-labelledby="notes-title">
  <div class="notes__inner">
    <header class="notes__head">
      <h2 class="v4-script notes__title" id="notes-title" data-v4-rise>{V4.notes.title}</h2>
      <p class="notes__lede" data-v4-rise set:html={bold(V4.notes.lede)} />
    </header>

    <ol class="notes__list">
      {
        V4.notes.items.map((n) => (
          <li class="note" data-v4-note>
            <span class="note__icon" aria-hidden="true" set:html={icons[n.icon]} />
            <div class="note__text">
              <h3 class="note__title">{n.title}</h3>
              <p class="note__body" set:html={bold(n.body)} />
            </div>
            <span class="v4-script note__n" aria-hidden="true">
              <span class="note__n-i">{n.n}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .notes {
    padding: 34px var(--gutter) 64px;
    background: var(--wine-deep);
    color: var(--ivory);
  }

  .notes__head {
    margin-top: 40px;
  }

  .notes__title {
    font-size: 56px;
    line-height: 0.95;
    letter-spacing: -0.015em;
  }

  .notes__lede {
    margin-top: 14px;
    font-family: var(--f-dm);
    font-weight: 500;
    font-size: 17px;
    line-height: 1.45;
    opacity: 0.82;
  }

  .notes__lede :global(strong) {
    font-weight: 700;
  }

  .notes__list {
    display: grid;
    gap: 10px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- A note: icon ring, words, outlined numeral ---------- */

  .note {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 16px;
    overflow: hidden;
    padding: 18px 64px 18px 16px;
    border: 1px solid rgb(217 185 168 / 0.2);
    border-radius: 10px;
    background: linear-gradient(120deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.015) 70%);
    transition:
      transform 0.5s var(--ease-out-expo),
      border-color 0.5s,
      background-color 0.5s;
  }

  .note__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid rgb(217 185 168 / 0.32);
    border-radius: 50%;
    transition:
      background-color 0.5s,
      border-color 0.5s;
  }

  .note__icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .note__icon :global(path) {
    stroke: var(--sand);
  }

  .note__title {
    font-family: var(--f-dm);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.25;
    letter-spacing: -0.2px;
    color: var(--shell);
  }

  .note__body {
    margin-top: 4px;
    font-family: var(--f-dm);
    font-size: 14px;
    line-height: 1.55;
    color: var(--mist);
  }

  .note__body :global(strong) {
    font-weight: 700;
    color: var(--shell);
  }

  /* The large outlined numeral, tucked into the row's far end. */
  .note__n {
    position: absolute;
    right: 14px;
    top: 50%;
    translate: 0 -50%;
    overflow: hidden;
    font-size: 72px;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgb(217 185 168 / 0.55);
    pointer-events: none;
    transition: transform 0.6s var(--ease-out-expo);
  }

  /* The rising part (scripts/v4.ts) - GSAP's alone, so no CSS transition. */
  .note__n-i {
    display: block;
  }

  @media (hover: hover) {
    .note:hover {
      transform: translateY(-3px);
      border-color: rgb(217 185 168 / 0.4);
      background-color: rgb(255 255 255 / 0.03);
    }

    .note:hover .note__icon {
      background-color: rgb(217 185 168 / 0.12);
      border-color: rgb(217 185 168 / 0.6);
    }

    .note:hover .note__n {
      transform: translateX(-6px);
    }
  }

  /* ---------- Desktop: heading still on the left, notes on the right ---------- */

  @media (min-width: 900px) {
    .notes {
      padding: calc(120 * var(--px)) var(--gutter) calc(120 * var(--px));
    }

    .notes__inner {
      display: grid;
      grid-template-columns: 5fr 7fr;
      align-items: start;
      gap: calc(72 * var(--px));
      max-width: 1180px;
      margin: 0 auto;
    }

    .notes__head {
      position: sticky;
      top: 140px;
      margin-top: 0;
    }

    .notes__title {
      font-size: calc(88 * var(--px));
      letter-spacing: calc(-1.3 * var(--px));
    }

    .notes__lede {
      margin-top: calc(18 * var(--px));
      font-size: max(16px, calc(19 * var(--px)));
    }

    .notes__list {
      gap: 14px;
      margin: 0;
    }

    .note {
      gap: 22px;
      padding: 26px 120px 26px 24px;
    }

    .note__icon {
      width: 56px;
      height: 56px;
    }

    .note__icon :global(svg) {
      width: 22px;
      height: 22px;
    }

    .note__title {
      font-size: 20px;
    }

    .note__body {
      margin-top: 6px;
      font-size: 15px;
    }

    .note__n {
      right: 24px;
      font-size: 112px;
    }
  }
</style>
