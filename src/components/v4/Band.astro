---
/**
 * V4: the wine band holding four photo-shoot portraits - two by two on
 * phones, one row of four on desktop - under the cream countdown card,
 * which sits on the seam with the hero above; then "We Invite You" with the
 * reply-by line and the button.
 *
 * The countdown is set like stationery: a small cream card with an inset
 * hairline frame, the line "Until we say I do" between two rules, the four
 * numbers in script divided by rose diamonds with small spaced-cap names
 * under them. scripts/v4.ts (countdown()) rolls each digit
 * like an odometer as it changes, and a hairline along the frame's foot
 * fills across every minute, so the clock is visibly running.
 *
 * Four photo-shoot frames only, none of them shown anywhere else on the
 * page: 04 (warm spotlight, sunglasses), 15 (grey spotlight, seated), 19
 * (white wall, in black) and 20 (hand in hand, in white). Left out on
 * purpose: the phone snaps, 01/03/06 (Moments), 02 (the story's ring
 * close-up), 07 (the back cover's twin), 11/14 (03's sofa scene), 13 (the
 * story's "together" photo) and 18 (04's twin).
 *
 * Motion (scripts/v4.ts, collage()): frames open upward in small batches as
 * they arrive, each photo settling from a slight zoom. Reduced motion: the
 * wall just sits.
 */
import Media from "../Media.astro";
import { V4 } from "../../lib/site";

/** Read left to right: warm spotlight, the wide white-wall frame, grey spotlight, hand in hand. */
const frames = [
  { n: 4, tone: "wine", wide: false },
  { n: 19, tone: "stone", wide: true },
  { n: 15, tone: "blush", wide: false },
  { n: 20, tone: "stone", wide: false },
].map((f, i) => ({ ...f, i, slug: `moment-${String(f.n).padStart(2, "0")}` }));
---

<section class="band" aria-label="Counting down to the day">
  <div class="count" data-v4-countdown data-target={V4.countdown.target} role="timer" aria-label={V4.countdown.eyebrow}>
    <span class="count__frame" aria-hidden="true"></span>
    <p class="count__eyebrow">{V4.countdown.eyebrow}</p>
    <div class="count__cells">
      {
        V4.countdown.units.map((u, i) => (
          <div class="count__cell">
            <span class="v4-script count__n" data-unit={String(i)}>--</span>
            <span class="count__label">{u}</span>
          </div>
        ))
      }
    </div>
    <span class="count__minute" aria-hidden="true" data-v4-minute></span>
  </div>

  <ul class="band__collage" data-v4-collage>
    {
      frames.map((f) => (
        <li class:list={["band__tile", `band__tile--${f.i + 1}`, { "band__tile--wide": f.wide }]} data-v4-tile>
          <Media slug={f.slug} label={f.slug} tone={f.tone as "wine" | "blush" | "stone"} sizes={f.wide ? "(min-width: 900px) 38vw, 100vw" : "(min-width: 900px) 22vw, 33vw"} class="band__img" />
        </li>
      ))
    }
  </ul>

</section>

<section class="invite" aria-labelledby="invite-title">
  <img class="v4-rings invite__rings" src="/v4/rings.webp" alt="" width="256" height="256" loading="lazy" data-v4-beat />
  <h2 class="v4-script invite__title" id="invite-title" data-v4-rise>{V4.invite.title}</h2>
  <p class="invite__lead" data-v4-rise>
    <span>{V4.invite.lead.trim()}</span>
    <strong class="invite__date">{V4.invite.date}</strong>
  </p>
  <a class="bv2 bv2--primary invite__cta" href="#rsvp" data-v4-rise>{V4.invite.cta}</a>

  <!-- Two lines of script that slide past each other as the page scrolls:
       solid wine one way, outlined the other (scripts/v4.ts, ribbon()). -->
  <div class="ribbon" aria-hidden="true" data-v4-ribbon>
    {
      ["solid", "outline"].map((kind) => (
        <div class={`ribbon__row ribbon__row--${kind}`} data-v4-ribbon-row>
          {[0, 1, 2, 3].map(() =>
            V4.invite.ribbon.map((part) => (
              <>
                <span class="v4-script ribbon__text">{part}</span>
                <span class="ribbon__mark" />
              </>
            )),
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  /* ---------- Band + film strip ---------- */

  /*
   * The countdown card sits on the seam between the hero and the band, half
   * over each - seen right after the names and the date, like a seal on the
   * envelope - and the wall of photos follows beneath it.
   */
  .band {
    position: relative;
    z-index: 1;
    /* Its own block context, so the card's negative margin isn't absorbed. */
    display: flow-root;
    padding: 0;
    background: var(--wine-deep);
  }

  /*
   * The photos hang over the band's lower edge into the invitation, the way
   * the countdown card hangs over its upper edge - one device, both seams.
   * Phones: the wide frame across the top, three portraits under it, the
   * middle one dropped a step. Desktop: one row, the wide frame second, the
   * portraits stepping up and down so the bottom edge reads as a rhythm.
   */
  .band__collage {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: start;
    gap: 8px;
    margin: 40px var(--gutter) -72px;
    padding: 0;
    list-style: none;
  }

  .band__tile {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 3px;
    /* A hairline and a deep, soft shadow keep the white-studio frames from
       melting into the white invitation where they hang over the seam. */
    box-shadow:
      0 0 0 1px rgb(30 20 22 / 0.08),
      0 24px 48px -20px rgb(34 7 13 / 0.45),
      0 6px 14px -6px rgb(34 7 13 / 0.2);
  }

  .band__tile--wide {
    grid-column: 1 / -1;
    order: -1;
    aspect-ratio: 3 / 2;
  }

  .band__tile--3 {
    margin-top: 24px;
  }

  .band__tile :global(.band__img),
  .band__tile :global(.media__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Countdown card: set like stationery ---------- */

  .count {
    position: relative;
    max-width: 560px;
    margin: -84px auto 0;
    margin-inline: max(var(--gutter), calc((100% - 560px) / 2));
    padding: 30px 12px 30px;
    background:
      radial-gradient(120% 90% at 50% 0%, rgb(255 255 255 / 0.55), transparent 60%),
      var(--cream);
    border-radius: 14px;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      0 24px 60px -18px rgb(34 7 13 / 0.55);
    text-align: center;
  }

  /* The inset hairline frame, like a letterpress border. */
  .count__frame {
    position: absolute;
    inset: 8px;
    border: 1px solid rgb(110 26 43 / 0.28);
    border-radius: 9px;
    pointer-events: none;
  }

  /* "Until we say I do", between two short rules. */
  .count__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-family: var(--f-dm);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.34em;
    text-indent: 0.34em;
    text-transform: uppercase;
    color: var(--wine);
  }

  .count__eyebrow::before,
  .count__eyebrow::after {
    content: "";
    width: 28px;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
  }

  .count__cells {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 14px;
  }

  .count__cell {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
  }

  /* A small rose diamond between the numbers, level with their middle. */
  .count__cell + .count__cell::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 5px;
    height: 5px;
    background: var(--rose);
    rotate: 45deg;
    translate: -50% -50%;
    font-size: 40px;
  }

  .count__n {
    display: inline-flex;
    font-size: 40px;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  /*
   * Odometer digits (scripts/v4.ts): each a short window, clipped top and
   * bottom only; its width eases between digits, so a wider one is never
   * cut at the sides. Androgy's digits fill the top 0.77em of the line
   * (measured), so the window stops 0.2em short of its foot - a rolling
   * digit shows only where digits sit, never below the line.
   */
  .count__n :global(.dg) {
    position: relative;
    display: inline-block;
    clip-path: inset(0 -0.5em 0.2em);
    text-align: center;
  }

  .count__n :global(.dg__v) {
    display: block;
  }

  /* The incoming digit, over the outgoing one (no translate: GSAP owns
     this element's transform). */
  .count__n :global(.dg__v + .dg__v) {
    position: absolute;
    inset: 0;
  }

  /* Small spaced caps, like "Until we say I do" above them. */
  .count__label {
    font-family: var(--f-dm);
    font-weight: 600;
    font-size: 8px;
    line-height: 1;
    letter-spacing: 0.26em;
    text-indent: 0.26em;
    text-transform: uppercase;
    color: var(--wine);
    opacity: 0.75;
  }

  /* Along the frame's foot: fills across each minute, then starts again. */
  .count__minute {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 8px;
    height: 1px;
    background: var(--wine);
    opacity: 0.7;
    transform-origin: 0 50%;
    transform: scaleX(var(--minute, 0));
    transition: transform 1s linear;
  }

  /* ---------- Invite ---------- */

  .invite {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: calc(72px + 56px) var(--gutter) 64px;
    background: var(--paper);
    text-align: center;
  }

  .invite__rings {
    width: 52px;
    min-width: 0;
    margin-bottom: 20px;
  }

  .invite__title {
    font-size: 56px;
    letter-spacing: 0.03em;
    color: var(--ink);
  }

  .invite__lead {
    display: grid;
    gap: 6px;
    max-width: 32ch;
    margin-top: 20px;
    font-family: var(--f-dm);
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  /* The one fact to act on, set apart in the serif. */
  .invite__date {
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: italic;
    font-size: 26px;
    line-height: 1.2;
    letter-spacing: 0;
    color: var(--wine);
  }

  .invite__cta {
    width: 100%;
    max-width: 320px;
    margin-top: 32px;
  }

  /* ---------- The ribbon: script sliding past, edge to edge ---------- */

  /* Clipped at the sides only, so the swashes above and below stay whole. */
  .ribbon {
    align-self: stretch;
    margin: 88px calc(-1 * var(--gutter)) -16px;
    overflow-x: clip;
  }

  .ribbon__row {
    display: flex;
    align-items: center;
    gap: 0.45em;
    width: max-content;
    font-size: 44px;
    line-height: 1.05;
    white-space: nowrap;
    will-change: transform;
  }

  .ribbon__row + .ribbon__row {
    margin-top: 4px;
  }

  .ribbon__text {
    color: var(--wine);
  }

  /* The second line in outline only, a lighter echo of the first. */
  .ribbon__row--outline .ribbon__text {
    color: transparent;
    -webkit-text-stroke: 1px var(--wine);
    opacity: 0.55;
  }

  /* A small rose diamond between the phrases. */
  .ribbon__mark {
    flex: none;
    width: 0.14em;
    height: 0.14em;
    background: var(--rose);
    rotate: 45deg;
  }

  /* ---------- Desktop: the frame at 1440 ---------- */

  @media (min-width: 900px) {
    /*
     * One row. The wide frame is 1.7 portraits across, so it stands at three
     * quarters of their height; the steps (0, 96, 40, 0) give the row its
     * rise and fall against the seam.
     */
    .band__collage {
      grid-template-columns: 1fr 1.7fr 1fr 1fr;
      gap: calc(20 * var(--px));
      max-width: calc(1320 * var(--px));
      margin: calc(72 * var(--px)) auto calc(-180 * var(--px));
      padding-inline: var(--gutter);
    }

    .band__tile {
      border-radius: 4px;
    }

    .band__tile--wide {
      grid-column: auto;
      order: 0;
      margin-top: calc(96 * var(--px));
    }

    .band__tile--3 {
      margin-top: calc(40 * var(--px));
    }

    .count {
      max-width: 700px;
      margin: -116px auto 0;
      padding: 38px 24px 34px;
    }

    .count__frame {
      inset: 10px;
    }

    .count__eyebrow {
      font-size: 11px;
    }

    .count__eyebrow::before,
    .count__eyebrow::after {
      width: 44px;
    }

    .count__cells {
      margin-top: 18px;
    }

    .count__n,
    .count__cell + .count__cell::before {
      font-size: 64px;
    }

    .count__label {
      font-size: 10px;
    }

    .invite {
      padding: calc((180 + 96) * var(--px)) var(--gutter) calc(88 * var(--px));
    }

    .invite__rings {
      width: calc(64 * var(--px));
      min-width: 48px;
      margin-bottom: calc(28 * var(--px));
    }

    .invite__title {
      font-size: calc(80 * var(--px));
      letter-spacing: calc(2.4 * var(--px));
    }

    .invite__lead {
      max-width: none;
      gap: calc(8 * var(--px));
      margin-top: calc(24 * var(--px));
      font-size: max(16px, calc(18 * var(--px)));
      letter-spacing: 0.4px;
    }

    .invite__date {
      font-size: max(26px, calc(36 * var(--px)));
    }

    .invite__cta {
      width: 254px;
      margin-top: calc(40 * var(--px));
    }

    .ribbon {
      margin-top: calc(128 * var(--px));
      margin-bottom: calc(-24 * var(--px));
    }

    .ribbon__row {
      font-size: calc(96 * var(--px));
    }

    .ribbon__row + .ribbon__row {
      margin-top: calc(6 * var(--px));
    }
  }

</style>
