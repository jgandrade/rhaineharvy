---
/**
 * V4: the wine band holding four photo-shoot portraits, set as keepsake
 * prints (an even white border, a slight tilt each) - the wide frame
 * over three on phones, one overlapping row of four on desktop - under the
 * cream countdown card,
 * which sits on the seam with the hero above; then "We Invite You" with the
 * reply-by line, the button, and two satin ribbons crossing beneath it.
 *
 * The countdown is set like stationery: a small cream card with an inset
 * hairline frame, the line "Until we say I do" between two rules, the four
 * numbers in script divided by rose diamonds with small spaced-cap names
 * under them. scripts/v4.ts (countdown()) rolls each digit
 * like an odometer as it changes, and a hairline along the frame's foot
 * fills across every minute, so the clock is visibly running.
 *
 * Four photo-shoot frames only, none of them shown anywhere else on the
 * page: 04 (warm spotlight, sunglasses), 15 (grey spotlight, seated), 19
 * (white wall, in black) and 20 (hand in hand, in white). Left out on
 * purpose: the phone snaps, 01/03/06 (Moments), 02 (the story's ring
 * close-up), 07 (the back cover's twin), 11/14 (03's sofa scene), 13 (the
 * story's "together" photo) and 18 (04's twin).
 *
 * Motion (scripts/v4.ts, collage()): prints drop softly into place in small
 * batches as they arrive, each photo settling from a slight zoom; hover
 * straightens and lifts one. Reduced motion: the prints just sit.
 */
import Media from "../Media.astro";
import { V4 } from "../../lib/site";

/** Read left to right: warm spotlight, the wide white-wall frame, grey spotlight, hand in hand. */
const frames = [
  { n: 4, tone: "wine", wide: false },
  { n: 19, tone: "stone", wide: true },
  { n: 15, tone: "blush", wide: false },
  { n: 20, tone: "stone", wide: false },
].map((f, i) => ({ ...f, i, slug: `moment-${String(f.n).padStart(2, "0")}` }));
---

<section class="band" aria-label="Counting down to the day">
  <div class="count" data-v4-countdown data-target={V4.countdown.target} role="timer" aria-label={V4.countdown.eyebrow}>
    <span class="count__frame" aria-hidden="true"></span>
    <p class="count__eyebrow">{V4.countdown.eyebrow}</p>
    <div class="count__cells">
      {
        V4.countdown.units.map((u, i) => (
          <div class="count__cell">
            <span class="v4-script count__n" data-unit={String(i)}>--</span>
            <span class="count__label">{u}</span>
          </div>
        ))
      }
    </div>
    <span class="count__minute" aria-hidden="true" data-v4-minute></span>
  </div>

  <ul class="band__collage" data-v4-collage>
    {
      frames.map((f) => (
        <li class:list={["band__tile", `band__tile--${f.i + 1}`, { "band__tile--wide": f.wide }]} data-v4-tile>
          <figure class="print">
            <div class="print__photo">
              <Media slug={f.slug} label={f.slug} tone={f.tone as "wine" | "blush" | "stone"} sizes={f.wide ? "(min-width: 900px) 38vw, 100vw" : "(min-width: 900px) 22vw, 33vw"} class="band__img" />
            </div>
          </figure>
        </li>
      ))
    }
  </ul>

</section>

<section class="invite" aria-labelledby="invite-title">
  <img class="v4-rings invite__rings" src="/v4/rings.webp" alt="" width="256" height="256" loading="lazy" data-v4-beat />
  <h2 class="v4-script invite__title" id="invite-title" data-v4-rise>{V4.invite.title}</h2>
  <p class="invite__lead" data-v4-rise>
    <span>{V4.invite.lead.trim()}</span>
    <strong class="invite__date">{V4.invite.date}</strong>
  </p>
  <a class="bv2 bv2--primary invite__cta" href="#rsvp" data-v4-rise>{V4.invite.cta}</a>

  <!-- Two satin ribbons crossing in a shallow X: wine over champagne, each
       drifting its own way. Each track holds the phrases twice, so sliding
       it half its width loops without a seam (pure CSS; reduced motion stops). -->
  <div class="ribbons" aria-hidden="true">
    {
      ["gold", "wine"].map((kind) => (
        <div class={`rib rib--${kind}`}>
          <div class="rib__track">
            {[0, 1, 2, 3, 4, 5].map(() =>
              V4.invite.ribbon.map((part) => (
                <>
                  <span class="rib__text">{part}</span>
                  <svg class="rib__mark" viewBox="0 0 16 16"><path d="M8 0c.6 4.2 3.2 7.4 8 8-4.8.6-7.4 3.8-8 8-.6-4.2-3.2-7.4-8-8 4.8-.6 7.4-3.8 8-8z" fill="currentColor" /></svg>
                </>
              )),
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* ---------- Band + film strip ---------- */

  /*
   * The countdown card sits on the seam between the hero and the band, half
   * over each - seen right after the names and the date, like a seal on the
   * envelope - and the wall of photos follows beneath it.
   */
  .band {
    position: relative;
    z-index: 1;
    /* Its own block context, so the card's negative margin isn't absorbed. */
    display: flow-root;
    padding: 0;
    background:
      radial-gradient(ellipse 70% 60% at 50% 30%, rgb(143 43 60 / 0.5), transparent 70%),
      var(--wine-deep);
  }

  /*
   * The photos as keepsake prints scattered on the wine: even white borders,
   * rounded corners, each set at its own
   * slight angle and overlapping its neighbour a touch. They hang over the
   * band's lower edge into the invitation, as the countdown card hangs over
   * its upper edge. Phones: the wide frame across the top, three prints
   * under it. Desktop: one row, the prints stepping up and down.
   */
  .band__collage {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: start;
    gap: 4px;
    margin: 44px var(--gutter) -84px;
    padding: 0;
    list-style: none;
  }

  .band__tile {
    transition: rotate 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), translate 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .band__tile--1 { rotate: -4deg; }
  .band__tile--2 { rotate: 1.5deg; }
  .band__tile--3 { rotate: 3deg; margin-top: 22px; }
  .band__tile--4 { rotate: -2.5deg; }

  .band__tile--wide {
    grid-column: 1 / -1;
    order: -1;
    width: 92%;
    justify-self: center;
    margin-bottom: 6px;
  }

  /* Pick one up: it straightens and lifts. */
  @media (hover: hover) {
    .band__tile:hover {
      z-index: 3;
      rotate: 0deg;
      translate: 0 -10px;
    }
  }

  .print {
    margin: 0;
    padding: 5px;
    border-radius: 10px;
    background: #fffdf9;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.7) inset,
      0 22px 40px -18px rgb(0 0 0 / 0.55),
      0 4px 10px -4px rgb(0 0 0 / 0.25);
  }

  .print__photo {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 6px;
  }

  .band__tile--wide .print__photo {
    aspect-ratio: 3 / 2;
  }

  .print__photo :global(.band__img),
  .print__photo :global(.media),
  .print__photo :global(.media__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }



  /* ---------- Countdown card: set like stationery ---------- */

  .count {
    position: relative;
    max-width: 560px;
    margin: -84px auto 0;
    margin-inline: max(var(--gutter), calc((100% - 560px) / 2));
    padding: 30px 12px 30px;
    background:
      radial-gradient(120% 90% at 50% 0%, rgb(255 255 255 / 0.55), transparent 60%),
      var(--cream);
    border-radius: 14px;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      0 24px 60px -18px rgb(34 7 13 / 0.55);
    text-align: center;
  }

  /* The inset hairline frame, like a letterpress border. */
  .count__frame {
    position: absolute;
    inset: 8px;
    border: 1px solid rgb(110 26 43 / 0.28);
    border-radius: 9px;
    pointer-events: none;
  }

  /* "Until we say I do", between two short rules. */
  .count__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-family: var(--f-dm);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.34em;
    text-indent: 0.34em;
    text-transform: uppercase;
    color: var(--wine);
  }

  .count__eyebrow::before,
  .count__eyebrow::after {
    content: "";
    width: 28px;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
  }

  .count__cells {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 14px;
  }

  .count__cell {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
  }

  /* A small rose diamond between the numbers, level with their middle. */
  .count__cell + .count__cell::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 5px;
    height: 5px;
    background: var(--rose);
    rotate: 45deg;
    translate: -50% -50%;
    font-size: 40px;
  }

  .count__n {
    display: inline-flex;
    font-size: 40px;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  /*
   * Odometer digits (scripts/v4.ts): each a short window, clipped top and
   * bottom only; its width eases between digits, so a wider one is never
   * cut at the sides. Androgy's digits fill the top 0.77em of the line
   * (measured), so the window stops 0.2em short of its foot - a rolling
   * digit shows only where digits sit, never below the line.
   */
  .count__n :global(.dg) {
    position: relative;
    display: inline-block;
    clip-path: inset(0 -0.5em 0.2em);
    text-align: center;
  }

  .count__n :global(.dg__v) {
    display: block;
  }

  /* The incoming digit, over the outgoing one (no translate: GSAP owns
     this element's transform). */
  .count__n :global(.dg__v + .dg__v) {
    position: absolute;
    inset: 0;
  }

  /* Small spaced caps, like "Until we say I do" above them. */
  .count__label {
    font-family: var(--f-dm);
    font-weight: 600;
    font-size: 8px;
    line-height: 1;
    letter-spacing: 0.26em;
    text-indent: 0.26em;
    text-transform: uppercase;
    color: var(--wine);
    opacity: 0.75;
  }

  /* Along the frame's foot: fills across each minute, then starts again. */
  .count__minute {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 8px;
    height: 1px;
    background: var(--wine);
    opacity: 0.7;
    transform-origin: 0 50%;
    transform: scaleX(var(--minute, 0));
    transition: transform 1s linear;
  }

  /* ---------- Invite ---------- */

  .invite {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: calc(72px + 56px) var(--gutter) 64px;
    background: var(--paper);
    text-align: center;
  }

  .invite__rings {
    width: 52px;
    min-width: 0;
    margin-bottom: 20px;
  }

  .invite__title {
    font-size: 56px;
    letter-spacing: 0.03em;
    color: var(--ink);
  }

  .invite__lead {
    display: grid;
    gap: 6px;
    max-width: 32ch;
    margin-top: 20px;
    font-family: var(--f-dm);
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  /* The one fact to act on, set apart in the serif. */
  .invite__date {
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: italic;
    font-size: 26px;
    line-height: 1.2;
    letter-spacing: 0;
    color: var(--wine);
  }

  .invite__cta {
    width: 100%;
    max-width: 320px;
    margin-top: 32px;
  }

  /* ---------- The ribbons: two satin bands crossing, edge to edge ---------- */

  .ribbons {
    position: relative;
    align-self: stretch;
    height: 170px;
    margin: 64px calc(-1 * var(--gutter)) -64px;
    overflow: clip;
  }

  .rib {
    position: absolute;
    left: -6%;
    right: -6%;
    top: 50%;
    display: flex;
    align-items: center;
    height: 46px;
    overflow: hidden;
    translate: 0 -50%;
    box-shadow: 0 14px 28px -12px rgb(34 7 13 / 0.45);
  }

  /* Satin: a sheen across the middle, darker at the folds, stitched edges. */
  .rib::before,
  .rib::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .rib::before {
    background: linear-gradient(180deg, rgb(0 0 0 / 0.18), rgb(255 255 255 / 0.16) 38%, rgb(255 255 255 / 0.04) 55%, rgb(0 0 0 / 0.2));
  }

  .rib::after {
    inset: 5px 0;
    border-block: 1px dashed currentColor;
    opacity: 0.35;
  }

  /* Phones tilt steeper, so the X still reads across a narrow screen. */
  .rib--gold {
    rotate: 7deg;
    background: #d8bf8c;
    color: var(--wine-deep);
  }

  .rib--wine {
    z-index: 1;
    rotate: -7deg;
    background: var(--wine);
    color: #f1e2bf;
  }

  .rib__track {
    display: flex;
    flex: none;
    align-items: center;
    gap: 22px;
    padding-right: 22px;
    white-space: nowrap;
    animation: rib-slide 70s linear infinite;
  }

  .rib--gold .rib__track {
    animation-direction: reverse;
    animation-duration: 85s;
  }

  .rib__text {
    font-family: var(--font-serif);
    font-size: 13px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .rib__mark {
    flex: none;
    width: 11px;
    height: 11px;
    opacity: 0.85;
  }

  @keyframes rib-slide {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rib__track {
      animation: none;
    }
  }

  /* ---------- Desktop: the frame at 1440 ---------- */

  @media (min-width: 900px) {
    /*
     * One row. The wide frame is 1.7 portraits across, so it stands at three
     * quarters of their height; the steps (0, 96, 40, 0) give the row its
     * rise and fall against the seam.
     */
    .band__collage {
      grid-template-columns: 1fr 1.7fr 1fr 1fr;
      gap: 0;
      max-width: calc(1320 * var(--px));
      margin: calc(80 * var(--px)) auto calc(-200 * var(--px));
      padding-inline: var(--gutter);
    }

    /* Prints overlap their neighbours a touch, like a hand laid them down. */
    .band__tile + .band__tile {
      margin-left: calc(-18 * var(--px));
    }

    .band__tile--wide {
      grid-column: auto;
      order: 0;
      width: auto;
      margin-top: calc(96 * var(--px));
      margin-bottom: 0;
    }

    .band__tile--3 {
      margin-top: calc(40 * var(--px));
    }

    .print {
      padding: 10px;
      border-radius: 14px;
    }

    .print__photo {
      border-radius: 8px;
    }



    .count {
      max-width: 700px;
      margin: -116px auto 0;
      padding: 38px 24px 34px;
    }

    .count__frame {
      inset: 10px;
    }

    .count__eyebrow {
      font-size: 11px;
    }

    .count__eyebrow::before,
    .count__eyebrow::after {
      width: 44px;
    }

    .count__cells {
      margin-top: 18px;
    }

    .count__n,
    .count__cell + .count__cell::before {
      font-size: 64px;
    }

    .count__label {
      font-size: 10px;
    }

    .invite {
      padding: calc((180 + 96) * var(--px)) var(--gutter) calc(88 * var(--px));
    }

    .invite__rings {
      width: calc(64 * var(--px));
      min-width: 48px;
      margin-bottom: calc(28 * var(--px));
    }

    .invite__title {
      font-size: calc(80 * var(--px));
      letter-spacing: calc(2.4 * var(--px));
    }

    .invite__lead {
      max-width: none;
      gap: calc(8 * var(--px));
      margin-top: calc(24 * var(--px));
      font-size: max(16px, calc(18 * var(--px)));
      letter-spacing: 0.4px;
    }

    .invite__date {
      font-size: max(26px, calc(36 * var(--px)));
    }

    .invite__cta {
      width: 254px;
      margin-top: calc(40 * var(--px));
    }

    .ribbons {
      height: calc(260 * var(--px));
      min-height: 190px;
      margin-top: calc(112 * var(--px));
      margin-bottom: calc(-88 * var(--px));
    }

    .rib {
      height: max(64px, calc(78 * var(--px)));
    }

    .rib--gold {
      rotate: 3deg;
    }

    .rib--wine {
      rotate: -3.5deg;
    }

    .rib::after {
      inset: 8px 0;
    }

    .rib__track {
      gap: 36px;
      padding-right: 36px;
    }

    .rib__text {
      font-size: max(17px, calc(21 * var(--px)));
    }

    .rib__mark {
      width: 15px;
      height: 15px;
    }
  }

</style>
