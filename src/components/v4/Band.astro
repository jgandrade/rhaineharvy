---
/**
 * V4: the wine band holding the couple's photos as a masonry wall - every
 * frame keeps its own shape (studio portraits, landscapes, phone snaps from
 * the road), so nothing is cropped to a grid. Two columns on phones, three
 * on desktop, four on very wide screens - under the cream countdown card,
 * which sits on the seam with the hero above; then "We Invite You" with the
 * reply-by line and the button.
 *
 * The countdown is set like stationery: a small cream card with an inset
 * hairline frame, the line "Until we say I do" between two rules, the four
 * numbers in script divided by rose diamonds with small spaced-cap names
 * under them. scripts/v4.ts (countdown()) rolls each digit
 * like an odometer as it changes, and a hairline along the frame's foot
 * fills across every minute, so the clock is visibly running.
 *
 * No photo appears twice on the page: the three the Moments section shows
 * large (01, 03, 06) stay out, and so do the near-twins - 11 and 14 (03's
 * sofa scene), 07 (01's chair, and the back cover's photo), 18 (04's
 * spotlight) and 13 (the story's "together" photo).
 *
 * Motion (scripts/v4.ts, collage()): frames open upward in small batches as
 * they arrive, each photo settling from a slight zoom. Reduced motion: the
 * wall just sits.
 */
import Media from "../Media.astro";
import { V4 } from "../../lib/site";

const leftOut = new Set([1, 3, 6, 7, 11, 13, 14, 18]);
const tones = ["wine", "blush", "stone"] as const;
const frames = Array.from({ length: 20 }, (_, i) => i + 1)
  .filter((n) => !leftOut.has(n))
  .map((n, i) => ({ slug: `moment-${String(n).padStart(2, "0")}`, tone: tones[i % tones.length]! }));
---

<section class="band" aria-label="Counting down to the day">
  <div class="count" data-v4-countdown data-target={V4.countdown.target} role="timer" aria-label={V4.countdown.eyebrow}>
    <span class="count__frame" aria-hidden="true"></span>
    <p class="count__eyebrow">{V4.countdown.eyebrow}</p>
    <div class="count__cells">
      {
        V4.countdown.units.map((u, i) => (
          <div class="count__cell">
            <span class="v4-script count__n" data-unit={String(i)}>--</span>
            <span class="count__label">{u}</span>
          </div>
        ))
      }
    </div>
    <span class="count__minute" aria-hidden="true" data-v4-minute></span>
  </div>

  <ul class="band__collage" data-v4-collage>
    {
      frames.map((f) => (
        <li class="band__tile" data-v4-tile>
          <Media slug={f.slug} label={f.slug} tone={f.tone} sizes="(min-width: 1680px) 24vw, (min-width: 900px) 32vw, 48vw" class="band__img" />
        </li>
      ))
    }
  </ul>

</section>

<section class="invite" aria-labelledby="invite-title">
  <img class="v4-rings invite__rings" src="/v4/rings.webp" alt="" width="256" height="256" loading="lazy" data-v4-beat />
  <h2 class="v4-script invite__title" id="invite-title" data-v4-rise>{V4.invite.title}</h2>
  <p class="invite__lead" data-v4-rise>{V4.invite.lead}<strong>{V4.invite.date}</strong></p>
  <a class="bv2 bv2--primary invite__cta" href="#rsvp" data-v4-rise>{V4.invite.cta}</a>

  <!-- Two lines of script that slide past each other as the page scrolls:
       solid wine one way, outlined the other (scripts/v4.ts, ribbon()). -->
  <div class="ribbon" aria-hidden="true" data-v4-ribbon>
    {
      ["solid", "outline"].map((kind) => (
        <div class={`ribbon__row ribbon__row--${kind}`} data-v4-ribbon-row>
          {[0, 1, 2, 3].map(() =>
            V4.invite.ribbon.map((part) => (
              <>
                <span class="v4-script ribbon__text">{part}</span>
                <span class="ribbon__mark" />
              </>
            )),
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  /* ---------- Band + film strip ---------- */

  /*
   * The countdown card sits on the seam between the hero and the band, half
   * over each - seen right after the names and the date, like a seal on the
   * envelope - and the wall of photos follows beneath it.
   */
  .band {
    position: relative;
    z-index: 1;
    /* Its own block context, so the card's negative margin isn't absorbed. */
    display: flow-root;
    padding: 0 0 48px;
    background: var(--wine-deep);
  }

  /*
   * Masonry by columns: frames flow top to bottom, then across, each at its
   * photo's own shape. Two columns on phones, three on desktop, four wide.
   */
  .band__collage {
    columns: 2;
    column-gap: 8px;
    margin: 40px var(--gutter) 0;
    padding: 0;
    list-style: none;
  }

  .band__tile {
    margin-bottom: 8px;
    overflow: hidden;
    border-radius: 4px;
    break-inside: avoid;
  }

  /* No fixed ratio: the photo's own width and height set the frame. */
  .band__tile :global(.media__img) {
    display: block;
    height: auto;
  }

  .band__tile :global(.media--ph) {
    aspect-ratio: 4 / 5;
  }

  /* ---------- Countdown card: set like stationery ---------- */

  .count {
    position: relative;
    max-width: 560px;
    margin: -84px auto 0;
    margin-inline: max(var(--gutter), calc((100% - 560px) / 2));
    padding: 30px 12px 30px;
    background:
      radial-gradient(120% 90% at 50% 0%, rgb(255 255 255 / 0.55), transparent 60%),
      var(--cream);
    border-radius: 14px;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      0 24px 60px -18px rgb(34 7 13 / 0.55);
    text-align: center;
  }

  /* The inset hairline frame, like a letterpress border. */
  .count__frame {
    position: absolute;
    inset: 8px;
    border: 1px solid rgb(110 26 43 / 0.28);
    border-radius: 9px;
    pointer-events: none;
  }

  /* "Until we say I do", between two short rules. */
  .count__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-family: var(--f-dm);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.34em;
    text-indent: 0.34em;
    text-transform: uppercase;
    color: var(--wine);
  }

  .count__eyebrow::before,
  .count__eyebrow::after {
    content: "";
    width: 28px;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
  }

  .count__cells {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 14px;
  }

  .count__cell {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
  }

  /* A small rose diamond between the numbers, level with their middle. */
  .count__cell + .count__cell::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 5px;
    height: 5px;
    background: var(--rose);
    rotate: 45deg;
    translate: -50% -50%;
    font-size: 40px;
  }

  .count__n {
    display: inline-flex;
    font-size: 40px;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  /*
   * Odometer digits (scripts/v4.ts): each a short window, clipped top and
   * bottom only; its width eases between digits, so a wider one is never
   * cut at the sides. Androgy's digits fill the top 0.77em of the line
   * (measured), so the window stops 0.2em short of its foot - a rolling
   * digit shows only where digits sit, never below the line.
   */
  .count__n :global(.dg) {
    position: relative;
    display: inline-block;
    clip-path: inset(0 -0.5em 0.2em);
    text-align: center;
  }

  .count__n :global(.dg__v) {
    display: block;
  }

  /* The incoming digit, over the outgoing one (no translate: GSAP owns
     this element's transform). */
  .count__n :global(.dg__v + .dg__v) {
    position: absolute;
    inset: 0;
  }

  /* Small spaced caps, like "Until we say I do" above them. */
  .count__label {
    font-family: var(--f-dm);
    font-weight: 600;
    font-size: 8px;
    line-height: 1;
    letter-spacing: 0.26em;
    text-indent: 0.26em;
    text-transform: uppercase;
    color: var(--wine);
    opacity: 0.75;
  }

  /* Along the frame's foot: fills across each minute, then starts again. */
  .count__minute {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 8px;
    height: 1px;
    background: var(--wine);
    opacity: 0.7;
    transform-origin: 0 50%;
    transform: scaleX(var(--minute, 0));
    transition: transform 1s linear;
  }

  /* ---------- Invite ---------- */

  .invite {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 56px var(--gutter) 64px;
    background: var(--paper);
    text-align: center;
  }

  .invite__rings {
    width: 64px;
    margin-bottom: 24px;
  }

  .invite__title {
    font-size: 56px;
    letter-spacing: 0.03em;
    color: var(--ink);
  }

  .invite__lead {
    max-width: 32ch;
    margin-top: 16px;
    font-family: var(--f-dm);
    font-size: 17px;
    line-height: 1.57;
    letter-spacing: 0.02em;
    color: var(--wine);
  }

  .invite__cta {
    width: 100%;
    max-width: 320px;
    margin-top: 28px;
  }

  /* ---------- The ribbon: script sliding past, edge to edge ---------- */

  /* Clipped at the sides only, so the swashes above and below stay whole. */
  .ribbon {
    align-self: stretch;
    margin: 72px calc(-1 * var(--gutter)) -16px;
    overflow-x: clip;
  }

  .ribbon__row {
    display: flex;
    align-items: center;
    gap: 0.45em;
    width: max-content;
    font-size: 52px;
    line-height: 1.05;
    white-space: nowrap;
    will-change: transform;
  }

  .ribbon__row + .ribbon__row {
    margin-top: 4px;
  }

  .ribbon__text {
    color: var(--wine);
  }

  /* The second line in outline only, a lighter echo of the first. */
  .ribbon__row--outline .ribbon__text {
    color: transparent;
    -webkit-text-stroke: 1px var(--wine);
    opacity: 0.55;
  }

  /* A small rose diamond between the phrases. */
  .ribbon__mark {
    flex: none;
    width: 0.14em;
    height: 0.14em;
    background: var(--rose);
    rotate: 45deg;
  }

  /* ---------- Desktop: the frame at 1440 ---------- */

  @media (min-width: 900px) {
    .band {
      padding-bottom: calc(80 * var(--px));
    }

    /* Bigger frames: three columns on desktop. */
    .band__collage {
      columns: 3;
      column-gap: calc(16 * var(--px));
      max-width: calc(1400 * var(--px));
      margin: calc(64 * var(--px)) auto 0;
    }

    .band__tile {
      margin-bottom: calc(16 * var(--px));
      border-radius: 6px;
    }

    .count {
      max-width: 700px;
      margin: -116px auto 0;
      padding: 38px 24px 34px;
    }

    .count__frame {
      inset: 10px;
    }

    .count__eyebrow {
      font-size: 11px;
    }

    .count__eyebrow::before,
    .count__eyebrow::after {
      width: 44px;
    }

    .count__cells {
      margin-top: 18px;
    }

    .count__n,
    .count__cell + .count__cell::before {
      font-size: 64px;
    }

    .count__label {
      font-size: 10px;
    }

    .invite {
      padding: calc(58 * var(--px)) var(--gutter) calc(76 * var(--px));
    }

    .invite__rings {
      width: calc(89 * var(--px));
      margin-bottom: calc(36 * var(--px));
    }

    .invite__title {
      font-size: calc(80 * var(--px));
      letter-spacing: calc(2.4 * var(--px));
    }

    .invite__lead {
      max-width: none;
      margin-top: calc(8 * var(--px));
      font-size: max(16px, calc(20 * var(--px)));
      letter-spacing: 0.4px;
    }

    .invite__cta {
      width: 254px;
      margin-top: calc(32 * var(--px));
    }

    .ribbon {
      margin-top: calc(110 * var(--px));
      margin-bottom: calc(-24 * var(--px));
    }

    .ribbon__row {
      font-size: calc(120 * var(--px));
    }

    .ribbon__row + .ribbon__row {
      margin-top: calc(6 * var(--px));
    }
  }

  /* Very wide screens: a fourth column, so frames stay a sensible size. */
  @media (min-width: 1680px) {
    .band__collage {
      columns: 4;
    }
  }
</style>
