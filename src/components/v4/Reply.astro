---
/**
 * V4 reply card on cream, sized like a reply card rather than a page: an
 * ivory card (640px at most) with a wine hairline frame, the wax seal
 * pressed over its top edge, "R.S.V.P." in Androgy, the attendance choice
 * as one framed selector (a wine panel slides under the chosen answer),
 * underlined fields two to a row, and the send button. Posts through scripts/rsvp.ts
 * (PUBLIC_RSVP_ENDPOINT).
 */
import Seal from "../Seal.astro";
import { CALENDAR, V4 } from "../../lib/site";

const R = V4.reply;
const F = R.fields;
---

<section class="reply" id="rsvp" aria-labelledby="rsvp-title">
  <div class="card">
    <div class="card__seal" data-rsvp-seal><Seal /></div>
    <span class="card__frame" aria-hidden="true"></span>

    <h2 class="v4-script card__title" id="rsvp-title">{R.title}</h2>
    <p class="card__sub">{R.sub}</p>
    <p class="card__facts">{R.facts}</p>

    <form class="card__form" data-rsvp novalidate>
      <fieldset class="tiles">
        <legend class="visually-hidden">Will you attend?</legend>
        <span class="tiles__thumb" aria-hidden="true"></span>
        {
          [
            { value: "yes", words: R.accept },
            { value: "no", words: R.decline },
          ].map((t) => (
            <label class="tile">
              <input type="radio" name="attending" value={t.value} required={t.value === "yes"} checked={t.value === "yes"} />
              <span class="tile__face">
                <span class="v4-script tile__word">{t.words[0]}</span>
                <span class="v2-label">{t.words[1]}</span>
              </span>
            </label>
          ))
        }
      </fieldset>

      <div class="fields">
        <div class="line">
          <input id="rsvp-name" name="name" type="text" autocomplete="name" placeholder=" " required />
          <label for="rsvp-name">{F.name}</label>
        </div>
        <div class="line">
          <input id="rsvp-contact" name="contact" type="text" autocomplete="email" placeholder=" " required />
          <label for="rsvp-contact">{F.contact}</label>
        </div>
        <div class="line line--wide" data-rsvp-more>
          <textarea id="rsvp-guests" name="guests" rows="2" placeholder=" "></textarea>
          <label for="rsvp-guests">{F.guests}</label>
        </div>
        <div class="line">
          <input id="rsvp-diet" name="dietary" type="text" placeholder=" " />
          <label for="rsvp-diet">{F.diet}</label>
        </div>
        <div class="line">
          <input id="rsvp-message" name="message" type="text" placeholder=" " />
          <label for="rsvp-message">{F.note}</label>
        </div>
      </div>

      <input class="visually-hidden" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <button class="bv2 bv2--primary card__submit" type="submit">{R.submit}</button>
      <p class="card__status" role="status" aria-live="polite" data-rsvp-status></p>
    </form>

    <div class="card__thanks" data-rsvp-thanks data-yes={R.thanks.yes} data-no={R.thanks.no} hidden>
      <p class="v4-script card__thanks-text" data-rsvp-thanks-text></p>
      <p class="card__cal" data-ledger-yes>
        {R.calendar}:
        <a href={CALENDAR.google} target="_blank" rel="noopener">Google</a>
        <a href={CALENDAR.ics} download>Apple or Outlook</a>
      </p>
    </div>
  </div>
</section>

<style>
  .reply {
    padding: 34px 0 80px;
    background: var(--cream);
    color: var(--ink);
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 640px;
    margin: 72px var(--gutter) 0;
    padding: 60px 22px 36px;
    background: var(--ivory);
    box-shadow: 0 18px 48px rgb(58 13 22 / 0.09);
    text-align: center;
  }

  .card__frame {
    position: absolute;
    inset: 10px;
    border: 1px solid var(--wine);
    opacity: 0.6;
    pointer-events: none;
  }

  .card__seal {
    position: absolute;
    top: 0;
    left: 50%;
    width: 72px;
    translate: -50% -50%;
    perspective: 800px;
  }

  .card__title {
    font-size: 40px;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .card__sub {
    margin-top: 10px;
    font-family: var(--f-dm);
    font-size: 15px;
    line-height: 1.45;
    opacity: 0.78;
  }

  .card__facts {
    margin-top: 12px;
    font-family: var(--f-dm);
    font-weight: 700;
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.18em;
    color: var(--wine);
  }

  .card__form {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-top: 24px;
  }

  /*
   * ---------- Attendance: one framed selector ----------
   * Both answers sit in a single hairline frame; a wine panel slides under
   * whichever is chosen, and its words turn ivory. One question, two
   * answers - read as a choice, not two buttons.
   */

  .tiles {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    width: 100%;
    margin: 0;
    padding: 5px;
    background: var(--white);
    border: 1px solid rgb(110 26 43 / 0.3);
    border-radius: 10px;
  }

  .tiles__thumb {
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: 5px;
    width: calc(50% - 5px);
    background: var(--wine);
    border-radius: 7px;
    box-shadow: 0 6px 16px -6px rgb(110 26 43 / 0.55);
    transition: translate 0.6s var(--ease-out-expo);
  }

  .tiles:has(input[value="no"]:checked) .tiles__thumb {
    translate: 100% 0;
  }

  :global(html.reduce-motion) .tiles__thumb {
    transition: none;
  }

  .tile {
    position: relative;
    cursor: pointer;
  }

  .tile input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .tile__face {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    gap: 2px;
    height: 64px;
    color: var(--ink);
    transition: color 0.45s var(--ease-out-expo);
  }

  .tile__face .v2-label {
    opacity: 0.6;
    transition: opacity 0.45s;
  }

  .tile__word {
    font-size: clamp(19px, 5.4vw, 24px);
    line-height: 1.2;
  }

  .tile input:checked + .tile__face {
    color: var(--ivory);
  }

  .tile input:checked + .tile__face .v2-label {
    opacity: 0.85;
  }

  .tile:not(:has(input:checked)):hover .tile__face {
    color: var(--wine);
  }

  .tile input:focus-visible + .tile__face {
    outline: 1px solid var(--wine);
    outline-offset: -4px;
    border-radius: 7px;
  }

  /*
   * ---------- Soft filled fields with floating labels ----------
   * Each field a rounded white box with a hairline border; its label sits
   * inside and floats up small as soon as there is something in it. Focus
   * draws the border in wine with a soft glow.
   */

  .fields {
    display: grid;
    gap: 10px 12px;
    width: 100%;
    margin-top: 16px;
    text-align: left;
  }

  .line {
    position: relative;
  }

  .line[hidden] {
    display: none;
  }

  .line input,
  .line textarea {
    display: block;
    width: 100%;
    padding: 22px 14px 8px;
    background: var(--white);
    border: 1px solid rgb(30 20 22 / 0.14);
    border-radius: 10px;
    font-family: var(--f-dm);
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink);
    resize: none;
    transition:
      border-color 0.3s,
      box-shadow 0.4s var(--ease-out-expo);
  }

  .line textarea {
    min-height: 78px;
  }

  .line input:hover,
  .line textarea:hover {
    border-color: rgb(30 20 22 / 0.26);
  }

  .line input:focus,
  .line textarea:focus {
    outline: none;
    border-color: var(--wine);
    box-shadow: 0 0 0 4px rgb(110 26 43 / 0.1);
  }

  .line label {
    position: absolute;
    left: 15px;
    top: 15px;
    right: 14px;
    overflow: hidden;
    font-family: var(--f-dm);
    font-size: 15px;
    line-height: 1.4;
    color: rgb(30 20 22 / 0.55);
    text-overflow: ellipsis;
    white-space: nowrap;
    pointer-events: none;
    transform-origin: left top;
    transition:
      transform 0.4s var(--ease-out-expo),
      color 0.3s;
  }

  .line input:focus + label,
  .line input:not(:placeholder-shown) + label,
  .line textarea:focus + label,
  .line textarea:not(:placeholder-shown) + label {
    transform: translateY(-9px) scale(0.74);
    color: var(--wine);
  }

  .line :global(.is-invalid) {
    border-color: var(--wine-mid);
    box-shadow: 0 0 0 4px rgb(110 26 43 / 0.08);
  }

  /* Full width, rounded like the selector; lifts a touch on hover. */
  .card__submit {
    width: 100%;
    height: 54px;
    margin-top: 22px;
    border-radius: 10px;
    box-shadow: 0 10px 24px -12px rgb(110 26 43 / 0.7);
    transition:
      transform 0.4s var(--ease-out-expo),
      box-shadow 0.4s var(--ease-out-expo),
      background-color 0.3s;
  }

  @media (hover: hover) {
    .card__submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 30px -12px rgb(110 26 43 / 0.75);
    }
  }

  /* Takes no room until there is something to say. */
  .card__status:empty {
    display: none;
  }

  .card__status {
    margin-top: 12px;
    font-family: var(--f-dm);
    font-size: 15px;
    color: var(--wine);
  }

  .card__thanks {
    margin-top: 32px;
  }

  .card__thanks-text {
    font-size: 34px;
    line-height: 1.05;
  }

  .card__cal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 16px;
    margin-top: 20px;
    font-family: var(--f-dm);
  }

  .card__cal[hidden] {
    display: none;
  }

  .card__cal a {
    color: var(--wine);
    border-bottom: 1px solid currentColor;
  }

  @media (min-width: 600px) {
    .fields {
      grid-template-columns: 1fr 1fr;
    }

    .line--wide {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 900px) {
    .reply {
      padding-bottom: calc(120 * var(--px));
    }

    .card {
      margin: calc(120 * var(--px)) auto 0;
      padding: 76px 56px 48px;
    }

    .card__frame {
      inset: 11px;
    }

    .card__seal {
      width: 88px;
    }

    .card__title {
      font-size: 52px;
      letter-spacing: -0.5px;
    }

    .card__sub {
      font-size: 17px;
    }

    .card__facts {
      margin-top: 14px;
      font-size: 12px;
      letter-spacing: 0.2em;
    }

    .card__form {
      margin-top: 30px;
    }

    .tile__face {
      height: 70px;
    }

    .tile__word {
      font-size: 26px;
    }

    .fields {
      margin-top: 18px;
    }

    .card__submit {
      margin-top: 24px;
    }
  }
</style>
