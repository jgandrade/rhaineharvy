---
/**
 * V4 reply card on cream, set as a two-panel invitation. The wine side: the
 * R&H wax seal, "R · S · V · P" in spaced caps, "Will you join us?" in
 * Androgy, the reply-by line, and the day and the place set like stationery.
 * The ivory side: one static form, the same for every guest - their name,
 * "Will you attend?" as two options sized like a field, "how many of you"
 * as four pills, an optional note, and send. Labels sit
 * above fields; text is 16px so phones never zoom. Phones: the wine side on top.
 * Posts through scripts/rsvp.ts (PUBLIC_RSVP_ENDPOINT).
 */
import { CALENDAR, V4 } from "../../lib/site";

const R = V4.reply;
const F = R.fields;
---

<section class="reply" id="rsvp" aria-labelledby="rsvp-title">
  <div class="card">
    <aside class="side">
      <img class="side__seal" src="/v4/gift-seal.webp" width="320" height="345" alt="" loading="lazy" data-rsvp-seal />
      <p class="v2-label side__eyebrow">{R.eyebrow}</p>
      <h2 class="v4-script side__title" id="rsvp-title">{R.title}</h2>
      <p class="side__sub"><span class="lg">{R.sub}</span><span class="sm">{R.subShort}</span></p>
      <dl class="side__facts">
        {
          R.facts.map((f) => (
            <div class="side__fact">
              <dt class="side__label">{f.label}</dt>
              {f.lines.map((l, i) => <dd><span class="lg">{l}</span><span class="sm">{f.short[i]}</span></dd>)}
            </div>
          ))
        }
      </dl>
    </aside>

    <div class="main">
    <span class="card__frame" aria-hidden="true"></span>
    <form class="card__form" data-rsvp novalidate>
      <!-- One static form: every guest sees the same four fields. -->
      <div class="field field--first">
        <label class="field__label" for="rsvp-name">{F.name}</label>
        <input class="field__input" id="rsvp-name" name="name" type="text" autocomplete="name" placeholder={F.namePh} required />
      </div>

      <fieldset class="field">
        <legend class="field__label"><span class="lg">{R.ask}</span><span class="sm">{F.short.ask}</span></legend>
        <div class="seg">
          {
            [
              { value: "yes", label: R.accept, icon: "M5 12.5l4.5 4.5L19 7.5" },
              { value: "no", label: R.decline, icon: "M7 7l10 10M17 7L7 17" },
            ].map((t) => (
              <label class={`seg__opt seg__opt--${t.value}`}>
                <input type="radio" name="attending" value={t.value} required={t.value === "yes"} />
                <span class="seg__face">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={t.icon} /></svg>
                  <span class="seg__long">{t.label[0]}</span>
                  <span class="seg__short">{t.label[1]}</span>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="field">
        <legend class="field__label"><span class="lg">{F.guests}</span><span class="sm">{F.short.guests}</span></legend>
        <div class="count">
          {
            [1, 2, 3, 4].map((n) => (
              <label class="count__opt">
                <input type="radio" name="guests" value={String(n)} checked={n === 1} />
                <span>{n}</span>
              </label>
            ))
          }
        </div>
        <p class="field__hint"><span class="lg">{F.guestsHint}</span><span class="sm">{F.short.guestsHint}</span></p>
      </fieldset>

      <div class="field">
        <label class="field__label" for="rsvp-message"><span class="lg">{F.note}</span><span class="sm">{F.short.note}</span> <span class="field__opt">({F.optional})</span></label>
        <textarea class="field__input" id="rsvp-message" name="message" rows="3" placeholder={F.notePh}></textarea>
      </div>

      <input class="visually-hidden" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <button class="bv2 bv2--primary card__submit" type="submit">{R.submit}</button>
      <p class="card__status" role="status" aria-live="polite" data-rsvp-status></p>
    </form>

    <div class="card__thanks" data-rsvp-thanks data-yes={R.thanks.yes} data-no={R.thanks.no} hidden>
      <p class="v4-script card__thanks-text" data-rsvp-thanks-text></p>
      <p class="card__cal" data-ledger-yes>
        {R.calendar}:
        <a href={CALENDAR.google} target="_blank" rel="noopener">Google</a>
        <a href={CALENDAR.ics} download>Apple or Outlook</a>
      </p>
    </div>
    </div>
  </div>
</section>

<style>
  .reply {
    padding: 34px 0 80px;
    background: var(--cream);
    color: var(--ink);
  }

  .card {
    position: relative;
    display: grid;
    max-width: 640px;
    margin: 56px var(--gutter) 0;
    overflow: hidden;
    border-radius: 24px;
    background: var(--ivory);
    box-shadow: 0 30px 70px -30px rgb(58 13 22 / 0.4), 0 6px 18px -8px rgb(58 13 22 / 0.12);
    text-align: center;
  }

  /* ---------- the invitation side ---------- */

  .side {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40px 24px 44px;
    background:
      radial-gradient(ellipse 80% 55% at 50% 30%, rgb(143 43 60 / 0.55), transparent 70%),
      var(--wine-deep);
    color: var(--ivory);
  }

  .side__seal {
    width: 72px;
    height: auto;
    filter: drop-shadow(0 8px 12px rgb(0 0 0 / 0.45));
  }

  .side__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
    color: #e3cfa8;
    letter-spacing: 0.32em;
  }

  .side__eyebrow::before,
  .side__eyebrow::after {
    content: "";
    width: 28px;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  .side__title {
    margin-top: 14px;
    font-size: 46px;
    line-height: 1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .side__sub {
    margin-top: 14px;
    text-wrap: balance;
    font-family: var(--font-serif);
    font-size: 15px;
    font-style: italic;
    line-height: 1.5;
    color: rgb(244 238 234 / 0.82);
  }

  .side__facts {
    display: grid;
    gap: 18px;
    width: 100%;
    max-width: 300px;
    margin: 26px 0 0;
    padding-top: 22px;
    border-top: 1px solid rgb(227 207 168 / 0.35);
  }

  .side__fact dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.5;
  }

  .side__label {
    margin-bottom: 4px;
    font-family: var(--f-dm);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #e3cfa8;
  }

  /* ---------- the form side ---------- */

  .main {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 30px 18px 30px;
  }

  .card__frame {
    position: absolute;
    inset: 8px;
    border: 1px solid rgb(110 26 43 / 0.35);
    border-radius: 16px;
    pointer-events: none;
  }

  .card__form {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  /*
   * ---------- The form, kept simple ----------
   * One question with two big answers, then a name, a count (yes only) and
   * an optional note. Every label sits above its field, every target is at
   * least 48px tall, and every field is 16px text so iPhones never zoom in.
   */

  .field {
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    text-align: left;
  }

  .field {
    margin-top: 20px;
  }

  .field--first {
    margin-top: 0;
  }

  .field[hidden] {
    display: none;
  }

  .field__label {
    display: block;
    margin-bottom: 10px;
    padding: 0;
    font-family: var(--f-dm);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--wine);
  }

  /* ---------- will you attend: two options, sized like a field ---------- */

  .seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .seg__opt,
  .count__opt {
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }

  .seg__opt {
    position: relative;
    cursor: pointer;
  }

  /* Small phones: "Accept" / "Decline", so each stays on one line. Only one
     of the two is ever displayed, so a screen reader hears it once. */
  .seg__long {
    display: none;
  }

  @media (min-width: 420px) {
    .seg__long {
      display: inline;
    }

    .seg__short {
      display: none;
    }
  }

  .seg__opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .seg__face {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    padding: 8px 10px;
    border: 1px solid rgb(30 20 22 / 0.16);
    border-radius: 12px;
    background: var(--white);
    font-family: var(--f-dm);
    font-weight: 500;
    font-size: 15px;
    line-height: 1.25;
    text-align: center;
    color: var(--ink);
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }

  .seg__face svg {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--wine);
  }

  .seg__opt input:checked + .seg__face {
    border-color: var(--wine);
    background: var(--wine);
    color: var(--ivory);
  }

  .seg__opt input:checked + .seg__face svg {
    color: #f1e2bf;
  }

  .seg__opt input:focus-visible + .seg__face {
    outline: 2px solid var(--wine);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .seg__opt:not(:has(input:checked)):hover .seg__face {
      border-color: rgb(110 26 43 / 0.45);
    }
  }

  /* ---------- text fields ---------- */

  .field__input {
    display: block;
    width: 100%;
    min-height: 52px;
    padding: 14px 16px;
    background: var(--white);
    border: 1px solid rgb(30 20 22 / 0.16);
    border-radius: 12px;
    font-family: var(--f-dm);
    /* 16px: below this, iPhones zoom the page on focus. */
    font-size: 16px;
    line-height: 1.4;
    color: var(--ink);
    resize: vertical;
    transition:
      border-color 0.3s,
      box-shadow 0.4s var(--ease-out-expo);
  }

  textarea.field__input {
    min-height: 96px;
  }

  .field__input::placeholder {
    color: rgb(30 20 22 / 0.42);
  }

  .field__input:focus {
    outline: none;
    border-color: var(--wine);
    box-shadow: 0 0 0 4px rgb(110 26 43 / 0.1);
  }

  .field :global(.is-invalid) {
    border-color: var(--wine-mid);
    box-shadow: 0 0 0 4px rgb(110 26 43 / 0.1);
  }

  .field__hint {
    margin-top: 8px;
    font-family: var(--f-dm);
    font-size: 13px;
    line-height: 1.45;
    color: rgb(30 20 22 / 0.6);
  }

  /* ---------- how many: four round pills ---------- */

  .count {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }

  .count__opt {
    position: relative;
    cursor: pointer;
  }

  .count__opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .count__opt span {
    display: grid;
    place-items: center;
    height: 52px;
    border: 1px solid rgb(30 20 22 / 0.16);
    border-radius: 999px;
    background: var(--white);
    font-family: var(--font-serif);
    font-size: 20px;
    color: var(--ink);
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }

  .count__opt input:checked + span {
    border-color: var(--wine);
    background: var(--wine);
    color: var(--ivory);
  }

  .count__opt input:focus-visible + span {
    outline: 2px solid var(--wine);
    outline-offset: 3px;
  }

  /* Full width, rounded like the selector; lifts a touch on hover. */
  .card__submit {
    width: 100%;
    height: 54px;
    margin-top: 22px;
    border-radius: 12px;
    box-shadow: 0 10px 24px -12px rgb(110 26 43 / 0.7);
    transition:
      transform 0.4s var(--ease-out-expo),
      box-shadow 0.4s var(--ease-out-expo),
      background-color 0.3s;
  }

  @media (hover: hover) {
    .card__submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 30px -12px rgb(110 26 43 / 0.75);
    }
  }

  /* Takes no room until there is something to say. */
  .card__status:empty {
    display: none;
  }

  .card__status {
    margin-top: 12px;
    font-family: var(--f-dm);
    font-size: 15px;
    color: var(--wine);
  }

  .card__thanks {
    margin-top: 32px;
  }

  .card__thanks-text {
    font-size: 34px;
    line-height: 1.05;
  }

  .card__cal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 16px;
    margin-top: 20px;
    font-family: var(--f-dm);
  }

  .card__cal[hidden] {
    display: none;
  }

  .card__cal a {
    color: var(--wine);
    border-bottom: 1px solid currentColor;
  }

  @media (min-width: 900px) {
    .reply {
      padding-bottom: calc(120 * var(--px));
    }

    /* Two panels side by side: the invitation left, the form right. */
    .card {
      grid-template-columns: 0.9fr 1.1fr;
      max-width: 1080px;
      margin: calc(110 * var(--px)) auto 0;
      border-radius: 32px;
    }

    .side {
      justify-content: center;
      padding: 56px 40px;
    }

    .side__seal {
      width: 96px;
    }

    .side__title {
      font-size: 62px;
    }

    .side__sub {
      font-size: 17px;
    }

    .side__facts {
      gap: 22px;
      max-width: 320px;
    }

    .side__fact dd {
      font-size: 18px;
    }

    .main {
      justify-content: center;
      padding: 56px 52px;
    }

    .card__frame {
      inset: 14px;
      border-radius: 20px;
    }


    .card__submit {
      margin-top: 24px;
    }
  }
  /* ---------- Phones: fewer words, one frame, a shorter wine panel ---------- */

  /* Long copy from 900px up; the short form below. Only one is ever shown,
     so a screen reader hears it once. */
  .sm {
    display: none;
  }

  .field__opt {
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: rgb(30 20 22 / 0.5);
  }

  @media (max-width: 899px) {
    .lg {
      display: none;
    }

    .sm {
      display: inline;
    }

    .card {
      margin-top: 40px;
      border-radius: 20px;
    }

    .side {
      padding: 30px 20px 28px;
    }

    .side__seal {
      width: 56px;
    }

    .side__eyebrow {
      margin-top: 12px;
    }

    .side__title {
      margin-top: 10px;
      font-size: 40px;
    }

    .side__sub {
      margin-top: 10px;
    }

    /* When | Where side by side, split by a hairline. */
    .side__facts {
      grid-template-columns: 1fr 1fr;
      gap: 0;
      max-width: 340px;
      margin-top: 20px;
      padding-top: 18px;
    }

    .side__fact + .side__fact {
      border-left: 1px solid rgb(227 207 168 / 0.35);
    }

    .side__fact dd {
      font-size: 15px;
      line-height: 1.4;
    }

    /* One frame is enough: the card edge. */
    .card__frame {
      display: none;
    }

    .main {
      padding: 26px 20px 24px;
    }

    .field {
      margin-top: 22px;
    }

    .field--first {
      margin-top: 0;
    }

    /* Sentence case, so the questions read as questions. */
    .field__label {
      margin-bottom: 8px;
      font-weight: 600;
      font-size: 15px;
      letter-spacing: 0;
      text-transform: none;
      color: var(--ink);
    }

    .field__hint {
      margin-top: 6px;
    }

    .seg__long {
      display: none;
    }

    .seg__short {
      display: inline;
    }

    .count__opt span {
      height: 48px;
    }

    textarea.field__input {
      min-height: 80px;
    }

    .card__submit {
      margin-top: 24px;
    }
  }
</style>
