---
/**
 * The close, Figma "B - Polished": a couple photo sinking into wine-night,
 * the closing line and the names over it, then three columns - ceremony,
 * reception, reply - and the foot bar of in-page links. Phones stack it all.
 */
import Media from "./Media.astro";
import Rich from "./Rich.astro";
import { CTA, EVENTS, FOOTER, SITE } from "../lib/site";

const cols = [
  { label: FOOTER.ceremony, ev: EVENTS[0]! },
  { label: FOOTER.reception, ev: EVENTS[1]! },
];
---

<footer class="footer" data-footer>
  <Media slug="footer" label="Footer - couple portrait" tone="wine" class="footer__media" />
  <div class="footer__shade" aria-hidden="true"></div>

  <div class="footer__close">
    <p class="v2-display-m footer__closing"><Rich text={FOOTER.closing} /></p>
    <p class="footer__names">
      <span>{SITE.bride}</span> <span><em>&amp;</em> {SITE.groom}</span>
    </p>
    <p class="v2-label footer__date">{FOOTER.date}</p>
  </div>

  <div class="footer__details">
    {
      cols.map(({ label, ev }) => (
        <div class="footer__col">
          <p class="v2-label footer__label">{label}</p>
          <p class="v2-title">{ev.timeShort}</p>
          <p class="v2-body">{ev.place}</p>
          <p class="v2-body footer__soft">{ev.address}</p>
          <a class="bv2 bv2--link-light footer__link" href={ev.map} target="_blank" rel="noopener">
            {FOOTER.directions}
            <span class="visually-hidden"> to {ev.venue} (opens Google Maps)</span>
          </a>
        </div>
      ))
    }
    <div class="footer__col">
      <p class="v2-label footer__label">{FOOTER.reply.label}</p>
      <p class="v2-title">{FOOTER.reply.title}</p>
      <p class="v2-body footer__soft">{FOOTER.reply.sub}</p>
      <a class="bv2 bv2--photo footer__btn" href={CTA.href} data-scroll-to>{CTA.label}</a>
    </div>
  </div>

  <div class="footer__bar">
    <nav class="footer__links" aria-label="Footer">
      {FOOTER.links.map((l) => <a class="bv2 bv2--link-light" href={l.href} data-scroll-to>{l.label}</a>)}
    </nav>
    <div class="footer__credits">
      <span class="v2-small footer__copy">{FOOTER.copyright}</span>
      <a class="bv2 bv2--link-light" href="#top" data-scroll-to>{FOOTER.top}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding: 96px var(--gutter);
    overflow: hidden;
    background: var(--wine-night);
    color: var(--ivory);
  }

  .footer > :not(.footer__shade, :global(.footer__media)) {
    position: relative;
  }

  .footer :global(.footer__media) {
    position: absolute;
    inset: 0;
  }

  .footer :global(.footer__media .media__img) {
    object-position: 50% 20%;
  }

  .footer__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(34 7 13 / 0.5),
      rgb(34 7 13 / 0.7) 35%,
      var(--wine-night) 60%
    );
  }

  /* ---------- Closing ---------- */

  .footer__close {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  /* m/Display XL 64 on two lines; Display XL 168 on one. */
  .footer__names {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: 64px;
    line-height: 0.95;
    letter-spacing: -0.96px;
  }

  .footer__names em {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--rose);
  }

  .footer__date {
    opacity: 0.82;
  }

  /* ---------- Columns ---------- */

  .footer__details {
    display: flex;
    flex-direction: column;
    gap: 32px;
    width: 100%;
    padding-top: 40px;
    border-top: 1px solid var(--ivory-faint);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .footer__label {
    color: var(--rose);
  }

  .footer__soft {
    opacity: 0.78;
  }

  .footer__btn {
    width: 100%;
    margin-top: 14px;
  }

  /* ---------- Foot bar ---------- */

  .footer__bar {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    padding-top: 24px;
    border-top: 1px solid var(--ivory-faint);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
  }

  .footer__credits {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer__copy {
    opacity: 0.7;
  }

  /* ---------- Desktop ---------- */

  @media (min-width: 900px) {
    .footer {
      gap: 0;
      padding: 160px 80px 40px;
    }

    .footer__shade {
      background: linear-gradient(
        to bottom,
        rgb(34 7 13 / 0.5),
        rgb(34 7 13 / 0.65) 45%,
        var(--wine-night) 80%
      );
    }

    .footer__close {
      gap: 24px;
    }

    .footer__names {
      display: block;
      font-size: min(168px, 11.67vw);
      line-height: 0.9;
      letter-spacing: -0.02em;
      white-space: nowrap;
    }

    .footer__details {
      flex-direction: row;
      gap: 64px;
      max-width: 1280px;
      margin-top: 121px;
      padding-top: 48px;
    }

    .footer__col {
      flex: 1 1 0;
      min-width: 0;
      gap: 8px;
    }

    /* Label, spacer 4, title: 8 + 4 + 8. */
    .footer__col > .v2-title {
      margin-top: 12px;
    }

    .footer__link {
      margin-top: 16px;
    }

    .footer__btn {
      width: auto;
      margin-top: 24px;
    }

    .footer__bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      max-width: 1280px;
      margin-top: 96px;
    }

    .footer__links {
      gap: 32px;
    }

    .footer__credits {
      gap: 40px;
    }
  }
</style>
