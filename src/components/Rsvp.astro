---
/**
 * The reply card. A printed RSVP card laid on a dark wine table: a hairline
 * frame set in from the edge, the seal pressed over its top edge, and the
 * classic wording - your name, then "joyfully accepts" or "regretfully
 * declines", ticked with a pen stroke. Underlined fields, like the lines on
 * a card. Posts to PUBLIC_RSVP_ENDPOINT (see src/scripts/rsvp.ts).
 */
import Seal from "./Seal.astro";
import { CALENDAR, EVENTS, RSVP, SITE } from "../lib/site";

const F = RSVP.fields;
const tick = `<svg class="mark__tick" viewBox="0 0 20 20" aria-hidden="true"><path pathLength="1" d="M4 10.5 8.5 15 16.5 4.5"/></svg>`;
---

<section class="rsvp" id="rsvp" aria-labelledby="rsvp-title">
  <div class="card">
    <div class="card__seal" data-rsvp-seal><Seal /></div>

    <h2 class="card__title" id="rsvp-title">{RSVP.title}</h2>
    <p class="card__sub">{RSVP.sub}</p>

    <form class="card__form" data-rsvp novalidate>
      <div class="line line--name">
        <label for="rsvp-name">{F.name} <span class="line__hint">{F.nameHint}</span></label>
        <input id="rsvp-name" name="name" type="text" autocomplete="name" required />
      </div>

      <fieldset class="choice">
        <legend class="visually-hidden">Will you attend?</legend>
        <label class="choice__opt">
          <input type="radio" name="attending" value="yes" required />
          <span class="mark"><Fragment set:html={tick} /></span>
          <span class="choice__text">{RSVP.accept}</span>
        </label>
        <label class="choice__opt">
          <input type="radio" name="attending" value="no" />
          <span class="mark"><Fragment set:html={tick} /></span>
          <span class="choice__text">{RSVP.decline}</span>
        </label>
      </fieldset>

      <div class="line">
        <label for="rsvp-contact">{F.contact}</label>
        <input id="rsvp-contact" name="contact" type="text" autocomplete="email" required />
      </div>

      <div class="card__more" data-rsvp-more>
        <div class="line">
          <label for="rsvp-guests">{F.guests} <span class="line__hint">{F.guestsHint}</span></label>
          <textarea id="rsvp-guests" name="guests" rows="2"></textarea>
        </div>
        <div class="line">
          <label for="rsvp-diet">{F.diet} <span class="line__hint">{F.optional}</span></label>
          <input id="rsvp-diet" name="dietary" type="text" />
        </div>
      </div>

      <div class="line">
        <label for="rsvp-message">{F.message} <span class="line__hint">{F.optional}</span></label>
        <textarea id="rsvp-message" name="message" rows="2"></textarea>
      </div>

      <!-- Bots fill every field; people never see this one. -->
      <input class="visually-hidden" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <button class="btn card__submit" type="submit">{RSVP.submit}</button>
      <p class="card__status" role="status" aria-live="polite" data-rsvp-status></p>
    </form>

    <div
      class="card__thanks"
      data-rsvp-thanks
      data-yes={RSVP.thanks.yes}
      data-no={RSVP.thanks.no}
      hidden
    >
      <p class="card__thanks-text" data-rsvp-thanks-text></p>

      <dl class="ledger">
        <div><dt>Name</dt><dd data-ledger="name"></dd></div>
        <div><dt>Reply</dt><dd data-ledger="attending"></dd></div>
        <div data-ledger-row="guests"><dt>Attending</dt><dd data-ledger="guests"></dd></div>
        <div data-ledger-yes><dt>Date</dt><dd>{SITE.dateLong}</dd></div>
        {
          EVENTS.map((e) => (
            <div data-ledger-yes>
              <dt>{e.name.replace(/^The /, "")}</dt>
              <dd>{e.timeShort}, {e.venue}</dd>
            </div>
          ))
        }
      </dl>

      <p class="ledger__cal" data-ledger-yes>
        {RSVP.calendar}:
        <a href={CALENDAR.google} target="_blank" rel="noopener">Google</a>
        <a href={CALENDAR.ics} download>Apple or Outlook</a>
      </p>
    </div>
  </div>
</section>

<style>
  .rsvp {
    padding: clamp(120px, 18vh, 200px) var(--gutter) clamp(72px, 12vh, 140px);
    background:
      radial-gradient(60% 50% at 50% 30%, rgb(143 43 60 / 0.4), transparent 75%),
      var(--wine-night);
  }

  .card {
    position: relative;
    display: grid;
    justify-items: center;
    max-width: 680px;
    margin: 0 auto;
    padding: clamp(64px, 9vw, 96px) clamp(22px, 7vw, 72px) clamp(40px, 6vw, 64px);
    background: var(--white);
    color: var(--ink);
    text-align: center;
    /* Printed frame: a hairline set in from the edge. */
    outline: 1px solid rgb(110 26 43 / 0.35);
    outline-offset: -14px;
    box-shadow: 0 60px 120px -40px rgb(0 0 0 / 0.6);
  }

  /* The seal is pressed over the card's top edge. */
  .card__seal {
    position: absolute;
    top: 0;
    left: 50%;
    width: clamp(88px, 10vw, 116px);
    translate: -50% -50%;
    perspective: 800px;
  }

  .card__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: italic;
    font-size: var(--fs-display-3);
    line-height: 1;
    text-wrap: balance;
  }

  .card__sub {
    margin-top: 14px;
    font-family: var(--font-serif);
    color: var(--ink-soft);
  }

  .card__form {
    display: grid;
    gap: 26px;
    width: 100%;
    margin-top: clamp(32px, 5vw, 48px);
    text-align: left;
  }

  .card__more {
    display: grid;
    gap: 26px;
  }

  .card__more[hidden] {
    display: none;
  }

  /* ---------- Lines: label above, an underline to write on ---------- */

  .line {
    display: grid;
    gap: 2px;
  }

  .line label {
    font-family: var(--font-serif);
    font-size: var(--fs-tiny);
    color: var(--wine);
  }

  .line__hint {
    font-style: italic;
    color: var(--ink-soft);
  }

  .line input,
  .line textarea {
    width: 100%;
    padding: 8px 0 10px;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgb(30 20 22 / 0.3);
    border-radius: 0;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.4;
    resize: vertical;
    transition: border-color 0.3s;
  }

  .line--name input {
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
  }

  .line input:focus,
  .line textarea:focus {
    outline: none;
    border-bottom-color: var(--wine);
    box-shadow: 0 1px 0 var(--wine);
  }

  .line :global(.is-invalid) {
    border-bottom-color: var(--wine-mid);
    box-shadow: 0 1px 0 var(--wine-mid);
  }

  /* ---------- Accepts / declines ---------- */

  .choice {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  @media (min-width: 560px) {
    .choice {
      grid-template-columns: auto auto;
      justify-content: start;
      column-gap: 40px;
    }
  }

  .choice__opt {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 48px;
    cursor: pointer;
  }

  .choice__opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid rgb(30 20 22 / 0.5);
  }

  /* The tick is drawn in, like a pen stroke, when chosen. */
  .mark :global(.mark__tick) {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--wine);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.45s var(--ease-out-quart);
  }

  .choice__opt input:checked + .mark :global(.mark__tick) {
    stroke-dashoffset: 0;
  }

  .choice__opt input:focus-visible + .mark {
    outline: 1px solid var(--wine);
    outline-offset: 3px;
  }

  .choice__text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.3125rem, 1.9vw, 1.5rem);
    line-height: 1.1;
    white-space: nowrap;
    transition: color 0.3s;
  }

  .choice__opt input:checked ~ .choice__text {
    color: var(--wine);
  }

  .card__submit {
    justify-self: center;
    min-width: 220px;
    min-height: 54px;
    margin-top: 10px;
    font-size: 1.0625rem;
  }

  .card__submit[disabled] {
    opacity: 0.6;
    pointer-events: none;
  }

  .card__status {
    min-height: 1.5em;
    margin-top: -12px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-tiny);
    color: var(--wine);
    text-align: center;
  }

  /* ---------- Thank you ---------- */

  .card__thanks {
    width: 100%;
    margin-top: 32px;
  }

  .card__thanks-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-display-2);
    line-height: 1.15;
    text-wrap: balance;
  }

  .ledger {
    margin: 32px 0 0;
    text-align: left;
  }

  .ledger div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--ink-faint);
  }

  .ledger div[hidden] {
    display: none;
  }

  .ledger dt {
    font-family: var(--font-serif);
    font-size: var(--fs-tiny);
    color: var(--wine);
    padding-top: 0.15em;
  }

  .ledger dd {
    margin: 0;
    font-family: var(--font-serif);
    white-space: pre-line;
  }

  .ledger__cal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 16px;
    margin-top: 24px;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ink-soft);
  }

  .ledger__cal[hidden] {
    display: none;
  }

  .ledger__cal a {
    color: var(--wine);
    border-bottom: 1px solid currentColor;
  }
</style>
