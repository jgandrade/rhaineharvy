---
/**
 * Sonnet 43, Figma "B - Polished". Desktop: poster-scale lines split either
 * side of a 120px lane through the middle, running off both edges, with the
 * wax seal at the top of the lane (motion.ts drifts the lines and sends the
 * seal down the lane on scroll). Phones: the seal, then each pair of half
 * lines as one centred two-line stanza.
 */
import Seal from "./Seal.astro";
import { VERSE } from "../lib/site";
---

<section class="verse" aria-label="A verse">
  <div class="verse__body" data-verse>
    <div class="verse__seal" data-verse-seal>
      <Seal />
    </div>

    <blockquote class="verse__lines">
      {
        VERSE.lines.map(([a, b], i) => (
          <p class="verse__line" data-verse-line={String(i)}>
            <span class="verse__half verse__half--a">{a}</span>
            <span class="verse__half verse__half--b">{b}</span>
          </p>
        ))
      }
    </blockquote>
  </div>
  <p class="v2-label verse__author">{VERSE.author}</p>
</section>

<style>
  .verse {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 96px var(--gutter);
    overflow: hidden;
    background: var(--ivory);
    color: var(--ink);
  }

  .verse__body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    width: 100%;
  }

  .verse__seal {
    width: 72px;
    perspective: 800px;
  }

  .verse__seal :global(.seal) {
    transform-style: preserve-3d;
  }

  .verse__lines {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin: 0;
  }

  /* Phones: a centred stanza, m/Display L. */
  .verse__line {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--font-display);
    font-size: 48px;
    line-height: 1;
    letter-spacing: -0.48px;
    text-align: center;
  }

  .verse__author {
    opacity: 0.78;
    text-align: center;
  }

  @media (min-width: 900px) {
    .verse {
      gap: 64px;
      padding: 160px 0;
    }

    .verse__body {
      display: block;
    }

    .verse__lines {
      gap: 0;
    }

    /* Display XL; each half anchored to the lane, overflowing the far edge. */
    .verse__line {
      display: grid;
      /* minmax(0, …): the halves overflow their tracks instead of widening them. */
      grid-template-columns: minmax(0, 1fr) min(120px, 8.33vw) minmax(0, 1fr);
      font-size: min(168px, 11.67vw);
      line-height: 0.9;
      letter-spacing: -0.02em;
      white-space: nowrap;
    }

    .verse__half--a {
      grid-column: 1;
      justify-self: end;
    }

    .verse__half--b {
      grid-column: 3;
      justify-self: start;
    }

    .verse__seal {
      position: absolute;
      z-index: 1;
      top: min(23.5px, 1.63vw);
      left: 50%;
      width: min(104px, 7.22vw);
      translate: -50% 0;
    }
  }
</style>
