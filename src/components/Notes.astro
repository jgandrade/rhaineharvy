---
/**
 * The three things every guest should know - the guest list, little ones,
 * gifts - written as the note a couple tucks into the envelope: a greeting,
 * three short paragraphs that each open on their subject in italic, and the
 * couple's names to sign it off.
 */
import Rich from "./Rich.astro";
import { NOTES, SITE } from "../lib/site";
---

<section class="notes" id="notes" aria-labelledby="notes-title">
  <header class="notes__head">
    <p class="eyebrow" data-reveal-fade><Rich text={NOTES.eyebrow} /></p>
    <h2 class="display display--md" id="notes-title" data-reveal><Rich text={NOTES.title} /></h2>
  </header>

  <div class="letter" data-fade>
    <p class="letter__greeting">{NOTES.greeting}</p>
    {
      NOTES.items.map((n) => (
        <p class="letter__para">
          <em>{n.lead}</em> {n.body}
        </p>
      ))
    }
    <p class="letter__closing">{NOTES.closing}</p>
    <p class="letter__sign">
      {SITE.bride} <span>&amp;</span> {SITE.groom}
    </p>
  </div>
</section>

<style>
  .notes {
    display: grid;
    justify-items: center;
    gap: clamp(40px, 6vw, 64px);
    padding: 20vh var(--gutter) 0;
  }

  .notes__head {
    display: grid;
    justify-items: center;
    gap: 18px;
  }

  /* One sheet of good paper: deckle-soft shadow, a faint wine rule at the top. */
  .letter {
    display: grid;
    gap: 1.1em;
    width: 100%;
    max-width: 640px;
    padding: clamp(36px, 7vw, 72px) clamp(24px, 7vw, 76px) clamp(40px, 7vw, 64px);
    background: var(--white);
    border-top: 3px solid var(--wine);
    box-shadow:
      0 1px 0 rgb(30 20 22 / 0.04),
      0 40px 80px -50px rgb(58 13 22 / 0.45);
    font-family: var(--font-serif);
    font-size: clamp(1.0625rem, 1.25vw, 1.1875rem);
    line-height: 1.75;
  }

  .letter__greeting {
    font-style: italic;
    font-size: var(--fs-title);
    line-height: 1.3;
  }

  .letter__para em {
    font-style: italic;
    color: var(--wine);
  }

  .letter__closing {
    margin-top: 0.6em;
    font-style: italic;
  }

  .letter__sign {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-style: italic;
    line-height: 1.1;
  }

  .letter__sign span {
    color: var(--rose);
  }
</style>
