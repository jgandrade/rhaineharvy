---
/**
 * The couple's own photos as a masonry wall: every frame keeps its true
 * shape (studio portraits, the odd landscape, phone snaps from the road), so
 * nothing is cropped to a grid. Two columns on phones, up to four on desktop.
 * Each frame opens upward as it arrives; the RSVP button closes the section.
 */
import Media from "./Media.astro";
import Rich from "./Rich.astro";
import { CTA, MOMENTS } from "../lib/site";

const COUNT = 20;
const tones = ["wine", "blush", "stone"] as const;
const items = Array.from({ length: COUNT }, (_, i) => ({
  slug: `moment-${String(i + 1).padStart(2, "0")}`,
  tone: tones[i % tones.length]!,
}));
---

<section class="moments" id="moments" aria-labelledby="moments-title">
  <header class="moments__head">
    <p class="eyebrow" data-reveal-fade><Rich text={MOMENTS.eyebrow} /></p>
    <h2 class="display display--md" id="moments-title" data-reveal><Rich text={MOMENTS.title} /></h2>
    <p class="prose prose--italic moments__lede" data-reveal-fade>{MOMENTS.lede}</p>
  </header>

  <ul class="moments__wall">
    {
      items.map((it, i) => (
        <li class="moments__item">
          <Media
            slug={it.slug}
            label={`Moment ${i + 1}`}
            tone={it.tone}
            sizes="(min-width: 1100px) 24vw, (min-width: 700px) 32vw, 48vw"
            data-mask
          />
        </li>
      ))
    }
  </ul>

  <div class="moments__cta" data-fade>
    <a class="btn" href={CTA.href} data-scroll-to><Rich text={CTA.label} /></a>
  </div>
</section>

<style>
  .moments {
    padding: 22vh var(--gutter) 0;
  }

  .moments__head {
    display: grid;
    justify-items: center;
    gap: 18px;
    margin-bottom: 9vh;
  }

  .moments__lede {
    max-width: 36ch;
    margin-top: 6px;
    color: var(--ink-soft);
  }

  /* Masonry by columns: frames flow top to bottom, then across. */
  .moments__wall {
    columns: 2;
    column-gap: var(--grid-gap);
    max-width: 1480px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 700px) {
    .moments__wall {
      columns: 3;
    }
  }

  @media (min-width: 1100px) {
    .moments__wall {
      columns: 4;
    }
  }

  .moments__item {
    break-inside: avoid;
    margin-bottom: var(--grid-gap);
  }

  /* No fixed ratio: the photo's own width/height sets the frame. Placeholders
     (no photo yet) fall back to a portrait. */
  .moments__item :global(.media--ph) {
    aspect-ratio: 4 / 5;
  }

  .moments__item :global(.media__img) {
    height: auto;
  }

  .moments__cta {
    display: flex;
    justify-content: center;
    padding: 10vh 0 4vh;
  }
</style>
