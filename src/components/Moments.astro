---
/**
 * Our moments, Figma "B - Polished": the head and a masonry wall of all
 * twenty photos, each in the crop the frame gives it. Desktop runs four
 * columns, phones two, in their own order - both arrangements are the
 * frame's, so each is laid out here as explicit columns. The wall for the
 * other width is display:none, so its lazy photos never load.
 */
import Media from "./Media.astro";
import Rich from "./Rich.astro";
import { MOMENTS } from "../lib/site";

type Tile = [n: number, h: number];
/** [moment number, height] down each column; width 342.5 desktop, 174 phone. */
const desktop: Tile[][] = [
  [[1, 514], [2, 229], [3, 514], [4, 514], [5, 456]],
  [[6, 229], [7, 514], [8, 456], [9, 456], [10, 229]],
  [[11, 514], [12, 456], [13, 514], [14, 229], [15, 514]],
  [[16, 421], [17, 514], [18, 514], [19, 229], [20, 514]],
];
const phone: Tile[][] = [
  [[10, 116], [12, 231], [14, 116], [15, 261], [17, 261], [19, 116], [1, 261], [3, 261], [5, 231], [8, 231]],
  [[11, 261], [13, 261], [16, 214], [18, 261], [20, 261], [2, 116], [4, 261], [6, 116], [7, 261], [9, 231]],
];
const tones = ["wine", "blush", "stone"] as const;
const slug = (n: number) => `moment-${String(n).padStart(2, "0")}`;
---

<section class="moments" id="moments" aria-labelledby="moments-title">
  <header class="v2-head">
    <p class="v2-label">{MOMENTS.eyebrow}</p>
    <h2 class="v2-display-l" id="moments-title" data-reveal><Rich text={MOMENTS.title} /></h2>
    <p class="v2-lede moments__lede">{MOMENTS.lede}</p>
  </header>

  {
    [
      { cols: desktop, w: 342.5, cls: "moments__wall--desktop", sizes: "(min-width: 900px) 24vw, 1px" },
      { cols: phone, w: 174, cls: "moments__wall--phone", sizes: "48vw" },
    ].map(({ cols, w, cls, sizes }) => (
      <div class={`moments__wall ${cls}`}>
        {cols.map((col) => (
          <ul class="moments__col">
            {col.map(([n, h]) => (
              <li class="moments__tile" style={`aspect-ratio:${w}/${h}`}>
                <Media slug={slug(n)} label={`Moment ${n}`} tone={tones[n % 3]!} sizes={sizes} class="moments__img" data-mask />
              </li>
            ))}
          </ul>
        ))}
      </div>
    ))
  }

  {
    MOMENTS.moreHref && (
      <a class="bv2 bv2--secondary moments__more" href={MOMENTS.moreHref} target="_blank" rel="noopener">
        {MOMENTS.more}
      </a>
    )
  }
</section>

<style>
  .moments {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding: 96px var(--gutter);
    background: var(--ivory);
    color: var(--ink);
  }

  .moments__lede {
    max-width: 560px;
    opacity: 0.82;
  }

  .moments__wall {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    width: 100%;
  }

  .moments__wall--desktop {
    display: none;
  }

  .moments__col {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moments__tile {
    position: relative;
  }

  .moments__tile :global(.moments__img) {
    position: absolute;
    inset: 0;
  }

  .moments__more {
    width: 100%;
  }

  @media (min-width: 900px) {
    .moments {
      gap: 0;
      padding: 160px var(--gutter);
    }

    .moments .v2-head {
      margin-bottom: 95px;
    }

    .moments__wall--desktop {
      display: flex;
    }

    .moments__wall--phone {
      display: none;
    }

    .moments__more {
      width: auto;
      margin-top: 64px;
    }
  }
</style>
