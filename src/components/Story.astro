---
/**
 * Our story, Figma "B - Polished": the head, then the three chapters side by
 * side (stacked on phones) - photo, chapter label, and the words "From
 * HELLO, / to YES, / to I DO." reading across.
 */
import Media from "./Media.astro";
import Rich from "./Rich.astro";
import { STORY } from "../lib/site";

const tones = ["wine", "stone", "wine"] as const;
---

<section class="story" id="story" aria-labelledby="story-title">
  <header class="v2-head">
    <p class="v2-label">{STORY.eyebrow}</p>
    <h2 class="v2-display-l" id="story-title" data-reveal><Rich text={STORY.title} /></h2>
  </header>

  <ol class="story__chapters">
    {
      STORY.steps.map((s, i) => (
        <li class="story__chapter">
          <Media
            slug={`story-${i + 1}`}
            label={`Story ${i + 1}`}
            tone={tones[i]}
            sizes="(min-width: 900px) 32vw, 100vw"
            class="story__photo"
            data-mask
          />
          <p class="v2-label story__label">{s.label}</p>
          <p class="v2-display-m story__words"><Rich text={s.words} /></p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .story {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding: 96px var(--gutter);
    background: var(--ivory);
    color: var(--ink);
  }

  .story__chapters {
    display: flex;
    flex-direction: column;
    gap: 40px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .story__chapter {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .story__chapter :global(.story__photo) {
    width: 100%;
    aspect-ratio: 358 / 440;
  }

  .story__label {
    color: var(--wine);
  }

  .story__words {
    white-space: nowrap;
  }

  @media (min-width: 900px) {
    .story {
      gap: 107px;
      padding: 160px var(--gutter);
    }

    .story__chapters {
      flex-direction: row;
      gap: 20px;
    }

    .story__chapter {
      flex: 1 1 0;
      min-width: 0;
      gap: 8px;
    }

    .story__chapter :global(.story__photo) {
      aspect-ratio: 453 / 600;
      margin-bottom: 16px;
    }
  }
</style>
