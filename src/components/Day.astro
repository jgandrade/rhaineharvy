---
/**
 * The day, Figma "B - Polished": the head, then the tall portrait beside the
 * details - the date, a line on the day, and three ruled rows (ceremony,
 * reception, dress code) - then a strip of five photos (a 2 x 2 + 1 grid on
 * phones) and the couple's quote.
 */
import Media from "./Media.astro";
import Rich from "./Rich.astro";
import { DAY, EVENTS } from "../lib/site";

const rows = [
  { ev: EVENTS[0]!, name: DAY.rows.ceremony },
  { ev: EVENTS[1]!, name: DAY.rows.reception },
];
const tones = ["wine", "stone", "wine", "stone", "wine"] as const;
---

<section class="day" id="the-day" aria-labelledby="day-title">
  <header class="v2-head">
    <p class="v2-label">{DAY.eyebrow}</p>
    <h2 class="v2-display-l" id="day-title" data-reveal><Rich text={DAY.title} /></h2>
  </header>

  <div class="day__main">
    <Media
      slug="day-portrait"
      label="Portrait - detail"
      tone="stone"
      sizes="(min-width: 900px) 48vw, 100vw"
      class="day__portrait"
      data-mask
    />

    <div class="day__details">
      <div class="day__intro">
        <p class="v2-title">{DAY.intro.date}</p>
        <p class="v2-lede day__lede">{DAY.intro.lede}</p>
      </div>

      <dl class="day__rows">
        {
          rows.map(({ ev, name }) => (
            <div class="row">
              <dt class="v2-label row__label">
                <span class="row__n">{ev.n}</span>
                <span class="row__name">{name}</span>
              </dt>
              <dd class="row__content">
                <span class="v2-title">{ev.time}</span>
                <span class="v2-body row__place">{ev.place}</span>
                <span class="v2-body row__soft">{ev.address}</span>
                <a class="bv2 bv2--secondary row__btn" href={ev.map} target="_blank" rel="noopener">
                  {DAY.directions}
                  <span class="visually-hidden"> to {ev.venue} (opens Google Maps)</span>
                </a>
              </dd>
            </div>
          ))
        }
        <div class="row">
          <dt class="v2-label row__label">
            <span class="row__n">{DAY.dressCode.n}</span>
            <span class="row__name">{DAY.dressCode.label}</span>
          </dt>
          <dd class="row__content">
            {
              DAY.dressCode.groups.map((g) => (
                <div class="dress">
                  <span class="v2-title dress__who">{g.who}</span>
                  {g.items.map((it) => (
                    <>
                      {it.role && <span class="v2-body row__place">{it.role}</span>}
                      <span class="v2-body">{it.value}</span>
                    </>
                  ))}
                  <span class="dress__swatches">
                    {g.colors.map((c) => (
                      <span class="v2-small dress__swatch">
                        <span class="dress__dot" style={`--swatch:${c.hex}`} aria-hidden="true" />
                        {c.name}
                      </span>
                    ))}
                  </span>
                </div>
              ))
            }
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="day__strip">
    {
      tones.map((tone, i) => (
        <Media
          slug={`day-${i + 1}`}
          label={`Day ${i + 1}`}
          tone={tone}
          sizes="(min-width: 900px) 19vw, 48vw"
          class={`day__photo day__photo--${i + 1}`}
          data-mask
        />
      ))
    }
  </div>

  <figure class="day__quote">
    <blockquote class="v2-display-m">{DAY.quote}</blockquote>
    <figcaption class="v2-label day__by">{DAY.quoteBy}</figcaption>
  </figure>
</section>

<style>
  .day {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding: 96px var(--gutter);
    background: var(--ivory);
    color: var(--ink);
  }

  /* ---------- Portrait + details ---------- */

  .day__main {
    display: flex;
    flex-direction: column;
    gap: 40px;
    width: 100%;
  }

  .day__main :global(.day__portrait) {
    width: 100%;
    aspect-ratio: 358 / 440;
  }

  .day__details {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .day__intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .day__lede {
    opacity: 0.82;
  }

  .day__rows {
    margin: 0;
    border-top: 1px solid var(--ink-faint);
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 0;
    border-bottom: 1px solid var(--ink-faint);
  }

  /* Phones: "I.  THE CEREMONY" on one wine line. */
  .row__label {
    display: flex;
    gap: 10px;
    color: var(--wine);
  }

  .row__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    margin: 0;
  }

  .row__place {
    font-weight: 700;
  }

  .row__soft {
    opacity: 0.78;
  }

  /* Spacer 8 between two 8px gaps. */
  .row__btn {
    width: 100%;
    margin-top: 16px;
  }

  .dress {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .dress + .dress {
    margin-top: 16px;
  }

  .dress__who {
    font-style: italic;
  }

  .dress__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .dress__swatch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .dress__dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--swatch);
  }

  /* ---------- Photo strip: 2 x 2 + 1 on phones ---------- */

  .day__strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    width: 100%;
  }

  .day__strip :global(.day__photo) {
    aspect-ratio: 174 / 232;
  }

  .day__strip :global(.day__photo--5) {
    grid-column: 1 / -1;
    aspect-ratio: 358 / 232;
  }

  /* ---------- Quote ---------- */

  .day__quote {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin: 0;
    text-align: center;
  }

  .day__quote blockquote {
    max-width: 960px;
    margin: 0;
  }

  .day__by {
    color: var(--wine);
  }

  /* ---------- Desktop ---------- */

  @media (min-width: 900px) {
    .day {
      gap: 0;
      padding: 160px var(--gutter);
    }

    .day__main {
      display: grid;
      grid-template-columns: 690fr 650fr;
      gap: 60px;
      align-items: start;
      margin-top: 96px;
    }

    .day__main :global(.day__portrait) {
      aspect-ratio: 690 / 1064;
    }

    .day__intro {
      gap: 12px;
    }

    .day__lede {
      max-width: 560px;
    }

    .row {
      flex-direction: row;
      gap: 24px;
      padding: 32px 0;
    }

    .row__label {
      flex: none;
      flex-direction: column;
      gap: 6px;
      width: 170px;
    }

    .row__name {
      color: var(--ink);
    }

    .row__content {
      flex: 1;
      gap: 6px;
    }

    .row__btn {
      width: auto;
      margin-top: 16px;
    }

    .dress {
      gap: 6px;
    }

    .dress + .dress {
      margin-top: 22px;
    }

    .dress__swatches {
      gap: 20px;
      margin-top: 10px;
    }

    .dress__swatch {
      opacity: 0.78;
    }

    .day__strip {
      display: flex;
      margin-top: 96px;
    }

    .day__strip :global(.day__photo),
    .day__strip :global(.day__photo--5) {
      flex: 1 1 0;
      min-width: 0;
      aspect-ratio: 272 / 362;
    }

    .day__quote {
      gap: 24px;
      margin-top: 160px;
    }
  }
</style>
