---
/**
 * Renders copy from site.ts. One string → inline; an array → one masked
 * line per entry, which motion.ts raises into place.
 */
import { rich } from "../lib/site";

interface Props {
  text: string | string[];
}

const { text } = Astro.props;
const lines = Array.isArray(text) ? text : null;
---

{
  lines ? (
    lines.map((l, i) => (
      <span class="line">
        {/* Lines are blocks, so the text itself needs the word break: without
            it screen readers and search snippets read "MOMENTled". */}
        <span class="line__inner" set:html={rich(l) + (i < lines.length - 1 ? " " : "")} />
      </span>
    ))
  ) : (
    <Fragment set:html={rich(text as string)} />
  )
}
